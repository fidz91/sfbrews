---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const recipePosts = (await getCollection('posts'))
  .filter((post) => isPostVisible(post) && (post.data.recipe !== undefined || post.data.category === 'recipe'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Homebrewing Recipes — SFBrews"
  description="All-grain homebrewing recipes with grist bill percentages, hop schedules, and brewday notes."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="page-head">
        <h1>Recipes &amp; Brewdays</h1>
        <p>All-grain formulations with grist bill percentages, hop schedules, water profiles, and brewday logs.</p>
      </header>

      {
        recipePosts.length > 0 ? (
          <div class="post-feed">
            {recipePosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="empty-msg">No recipes published yet.</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 4rem;
  }

  .page-head {
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .page-head p {
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.75rem 2.75rem;
  }

  .empty-msg {
    color: var(--text-muted);
    padding: 2.5rem 0;
  }

  @media (max-width: 960px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2.5rem;
    }
    .post-feed {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
