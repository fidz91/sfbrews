---
import { srmToHex, srmDescription } from '../utils/srm';

interface Fermentable {
  name: string;
  weight: string;
  percentage: number;
  lovibond?: string;
  notes?: string;
}

interface Hop {
  name: string;
  weight: string;
  alphaAcid?: string;
  timing: string;
  use?: string;
  ibuContribution?: number;
}

interface MashStep {
  step: string;
  temp: string;
  duration: string;
  notes?: string;
}

interface RecipeData {
  batchSize: string;
  boilTime: string;
  efficiency?: string;
  og: number;
  fg: number;
  abv: number;
  ibu: number;
  srm: number;
  fermentables: Fermentable[];
  hops: Hop[];
  yeast: {
    name: string;
    lab?: string;
    code?: string;
    attenuation?: string;
    tempRange?: string;
    pitchNotes?: string;
  };
  mash?: MashStep[];
  waterProfile?: {
    profileName?: string;
    ca?: number;
    mg?: number;
    na?: number;
    cl?: number;
    so4?: number;
    hco3?: number;
    mashPh?: number;
    notes?: string;
  };
  fermentationNotes?: string;
}

interface Props {
  recipe: RecipeData;
  beerName: string;
  beerStyle?: string;
  batchNumber?: string;
}

const { recipe, beerName, beerStyle, batchNumber } = Astro.props;
const glassColor = srmToHex(recipe.srm);
const colorName = srmDescription(recipe.srm);
---

<section class="m3-recipe-sheet" aria-label="Technical Recipe Sheet">
  <!-- Telemetry Header Card -->
  <div class="m3-recipe-header-card">
    <div class="m3-recipe-header-top">
      <div class="m3-recipe-title-row">
        <span class="m3-recipe-icon">
          <span class="material-symbols-outlined filled" aria-hidden="true">menu_book</span>
        </span>
        <div>
          <h2 class="m3-recipe-title">{beerName} — Recipe Sheet</h2>
          <p class="m3-recipe-sub">
            {batchNumber && <span>{batchNumber} &bull; </span>}
            {beerStyle && <span>{beerStyle} &bull; </span>}
            <span>Batch {recipe.batchSize}</span> &bull; <span>Boil {recipe.boilTime}</span>
            {recipe.efficiency && <span> &bull; Efficiency {recipe.efficiency}</span>}
          </p>
        </div>
      </div>

      <div class="m3-srm-badge" title={`Estimated color: ${recipe.srm} SRM (${colorName})`}>
        <span class="m3-srm-swatch" style={`background-color: ${glassColor};`}></span>
        <span>
          <strong>{recipe.srm} SRM</strong> ({colorName})
        </span>
      </div>
    </div>

    <div class="m3-metrics-grid">
      <div class="m3-metric-tile">
        <span class="m3-metric-label">OG &rarr; FG</span>
        <strong class="m3-metric-val">
          {recipe.og.toFixed(3)} &rarr; {recipe.fg.toFixed(3)}
        </strong>
      </div>
      <div class="m3-metric-tile">
        <span class="m3-metric-label">ABV</span>
        <strong class="m3-metric-val">{recipe.abv.toFixed(1)}%</strong>
      </div>
      <div class="m3-metric-tile">
        <span class="m3-metric-label">Bitterness</span>
        <strong class="m3-metric-val">{recipe.ibu} IBU</strong>
      </div>
      <div class="m3-metric-tile">
        <span class="m3-metric-label">Yeast</span>
        <strong class="m3-metric-val sm">
          {recipe.yeast.lab ? `${recipe.yeast.lab} ` : ''}
          {recipe.yeast.name}
        </strong>
      </div>
    </div>
  </div>

  <!-- Grist / Fermentables -->
  <div class="m3-table-section">
    <h3 class="m3-sec-heading">Fermentables &amp; Grist Bill</h3>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fermentable</th>
            <th>Weight</th>
            <th>Grist %</th>
            <th>Color</th>
          </tr>
        </thead>
        <tbody>
          {
            recipe.fermentables.map((grain) => (
              <tr>
                <td>
                  <strong>{grain.name}</strong>
                  {grain.notes && <div class="grain-note">{grain.notes}</div>}
                </td>
                <td class="nowrap font-stat-numeric">{grain.weight}</td>
                <td class="grist-cell">
                  <div class="grist-bar-wrap">
                    <span class="grist-pct font-stat-numeric">{grain.percentage}%</span>
                    <div class="grist-track">
                      <div class="grist-fill" style={`width: ${Math.min(grain.percentage, 100)}%;`} />
                    </div>
                  </div>
                </td>
                <td class="nowrap font-stat-numeric">{grain.lovibond || '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Hop Schedule -->
  <div class="m3-table-section">
    <h3 class="m3-sec-heading">Hop Additions</h3>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Hop Variety</th>
            <th>Weight</th>
            <th>AA%</th>
            <th>Stage &amp; Timing</th>
            <th>IBUs</th>
          </tr>
        </thead>
        <tbody>
          {
            recipe.hops.map((hop) => (
              <tr>
                <td>
                  <strong>{hop.name}</strong>
                </td>
                <td class="nowrap font-stat-numeric">{hop.weight}</td>
                <td class="nowrap font-stat-numeric">{hop.alphaAcid || '—'}</td>
                <td class="nowrap">
                  <span class="hop-use-chip">
                    {hop.use ? `${hop.use} @ ${hop.timing}` : hop.timing}
                  </span>
                </td>
                <td class="nowrap font-stat-numeric">
                  {hop.ibuContribution !== undefined ? `${hop.ibuContribution} IBU` : '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mash, Yeast & Water Sub-Cards -->
  <div class="m3-subcards-grid">
    {
      recipe.mash && recipe.mash.length > 0 && (
        <div class="m3-subcard">
          <div class="m3-subcard-head">
            <span class="material-symbols-outlined" aria-hidden="true">device_thermostat</span>
            <strong>Mash Schedule</strong>
          </div>
          <ul class="m3-subcard-list">
            {recipe.mash.map((step) => (
              <li>
                <strong>{step.step}:</strong> {step.temp} for {step.duration}
                {step.notes ? ` — ${step.notes}` : ''}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="m3-subcard">
      <div class="m3-subcard-head">
        <span class="material-symbols-outlined" aria-hidden="true">biotech</span>
        <strong>Yeast &amp; Fermentation</strong>
      </div>
      <p class="m3-subcard-text">
        <strong>
          {recipe.yeast.lab ? `${recipe.yeast.lab} ` : ''}
          {recipe.yeast.code ? `${recipe.yeast.code} ` : ''}
          {recipe.yeast.name}
        </strong>
        {recipe.yeast.attenuation && ` • Attenuation: ${recipe.yeast.attenuation}`}
        {recipe.yeast.tempRange && ` • Temp: ${recipe.yeast.tempRange}`}
        {recipe.yeast.pitchNotes && <br />}
        {recipe.yeast.pitchNotes && <span>{recipe.yeast.pitchNotes}</span>}
      </p>
      {recipe.fermentationNotes && <p class="m3-subcard-note">{recipe.fermentationNotes}</p>}
    </div>

    {
      recipe.waterProfile && (
        <div class="m3-subcard full-span">
          <div class="m3-subcard-head">
            <span class="material-symbols-outlined" aria-hidden="true">water_drop</span>
            <strong>
              Water Chemistry
              {recipe.waterProfile.profileName ? ` (${recipe.waterProfile.profileName})` : ''}
            </strong>
          </div>
          <div class="ion-pills">
            {recipe.waterProfile.ca !== undefined && (
              <span class="ion-pill">
                Ca²⁺ <strong>{recipe.waterProfile.ca}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.mg !== undefined && (
              <span class="ion-pill">
                Mg²⁺ <strong>{recipe.waterProfile.mg}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.na !== undefined && (
              <span class="ion-pill">
                Na⁺ <strong>{recipe.waterProfile.na}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.so4 !== undefined && (
              <span class="ion-pill">
                SO₄²⁻ <strong>{recipe.waterProfile.so4}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.cl !== undefined && (
              <span class="ion-pill">
                Cl⁻ <strong>{recipe.waterProfile.cl}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.hco3 !== undefined && (
              <span class="ion-pill">
                HCO₃⁻ <strong>{recipe.waterProfile.hco3}</strong> ppm
              </span>
            )}
            {recipe.waterProfile.mashPh !== undefined && (
              <span class="ion-pill ph">
                Mash pH <strong>{recipe.waterProfile.mashPh.toFixed(2)}</strong>
              </span>
            )}
          </div>
          {recipe.waterProfile.notes && <p class="m3-subcard-note">{recipe.waterProfile.notes}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  .m3-recipe-sheet {
    margin: 0 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .m3-recipe-header-card {
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 1.75rem;
    box-shadow: var(--md-sys-elevation-1);
  }

  .m3-recipe-header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.35rem;
  }

  .m3-recipe-title-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .m3-recipe-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--md-sys-shape-corner-medium);
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .m3-recipe-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    color: var(--md-sys-color-on-surface);
  }

  .m3-recipe-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--md-sys-color-on-surface-variant);
    margin-top: 0.2rem;
  }

  .m3-srm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.9rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--md-sys-color-on-surface);
  }

  .m3-srm-swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(23, 29, 20, 0.25);
  }

  .m3-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .m3-metric-tile {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 0.95rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .m3-metric-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--md-sys-color-outline);
  }

  .m3-metric-val {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--md-sys-color-primary);
    font-variant-numeric: tabular-nums;
  }

  .m3-metric-val.sm {
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--md-sys-color-on-surface);
  }

  .m3-sec-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--md-sys-color-on-surface);
  }

  .grain-note {
    font-size: 0.8rem;
    color: var(--md-sys-color-on-surface-variant);
    margin-top: 0.15rem;
  }

  .grist-cell {
    min-width: 140px;
  }

  .grist-bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .grist-pct {
    min-width: 44px;
    font-size: 0.85rem;
  }

  .grist-track {
    flex: 1;
    height: 8px;
    background-color: var(--md-sys-color-surface-container-high);
    border-radius: var(--md-sys-shape-corner-full);
    overflow: hidden;
  }

  .grist-fill {
    height: 100%;
    background-color: var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-corner-full);
  }

  .hop-use-chip {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .m3-subcards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .m3-subcard {
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 1.35rem;
  }

  .m3-subcard.full-span {
    grid-column: 1 / -1;
  }

  .m3-subcard-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--md-sys-color-primary);
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .m3-subcard-list {
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .m3-subcard-text {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--md-sys-color-on-surface-variant);
  }

  .m3-subcard-note {
    margin-top: 0.55rem;
    font-size: 0.84rem;
    color: var(--md-sys-color-outline);
  }

  .ion-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .ion-pill {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 0.35rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--md-sys-color-on-surface);
  }

  .ion-pill.ph {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-color: var(--md-sys-color-secondary);
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .m3-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .m3-subcards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
