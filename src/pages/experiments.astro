---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const experimentPosts = (await getCollection('posts'))
  .filter((post) => isPostVisible(post) && (post.data.category === 'experiment' || post.data.experiment !== undefined))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Brewing Experiments — SFBrews"
  description="Controlled split-batch homebrewing experiments and sensory comparisons."
>
  <div class="container page-wrap">
    <header class="page-head">
      <span class="mono-label page-kicker">Split-Batch Trials</span>
      <h1>Brewing Experiments</h1>
      <p>Controlled split-batch trials, ingredient comparisons, and blind triangle tests.</p>
    </header>

    {
      experimentPosts.length > 0 ? (
        <div class="post-grid">
          {experimentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-box">
          <p><strong>No experiments published yet.</strong></p>
          <p class="muted">
            Split-batch trials and brewing experiments will be added here as they are completed.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 2.5rem;
  }

  .page-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-kicker {
    display: block;
    color: var(--forest);
    margin-bottom: 0.4rem;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 3.8vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.45rem;
  }

  .page-head p {
    color: var(--ink-secondary);
    font-size: 1rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .empty-box {
    padding: 1.5rem;
    border-radius: var(--radius);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .muted {
    color: var(--ink-secondary);
    font-size: 0.92rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 760px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
