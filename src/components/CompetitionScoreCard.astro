---
interface CompetitionData {
  eventName: string;
  date: string;
  location?: string;
  bjcpCategory: string;
  entryBeer: string;
  batchNumber?: string;
  score?: number;
  maxScore: number;
  award: 'Best of Show' | 'Gold' | 'Silver' | 'Bronze' | 'Finalist' | 'Entered' | 'Pending';
  scoresBreakdown?: {
    aroma: number;
    appearance: number;
    flavor: number;
    mouthfeel: number;
    overall: number;
  };
  judgeConsensus?: string;
  recipeImprovements?: string;
}

interface Props {
  competition: CompetitionData;
}

const { competition } = Astro.props;
const breakdownItems = competition.scoresBreakdown
  ? [
      { label: 'Aroma', val: competition.scoresBreakdown.aroma, max: 12 },
      { label: 'Appearance', val: competition.scoresBreakdown.appearance, max: 3 },
      { label: 'Flavor', val: competition.scoresBreakdown.flavor, max: 20 },
      { label: 'Mouthfeel', val: competition.scoresBreakdown.mouthfeel, max: 5 },
      { label: 'Overall', val: competition.scoresBreakdown.overall, max: 10 },
    ]
  : [];
---

<section class="comp-sheet">
  <div class="comp-head">
    <div>
      <span class="mono-label">
        {competition.eventName}
        {competition.location ? ` · ${competition.location}` : ''} ({competition.date})
      </span>
      <h3 class="comp-title">
        {competition.entryBeer}
        {competition.batchNumber ? ` (${competition.batchNumber})` : ''} &middot; BJCP {competition.bjcpCategory}
      </h3>
    </div>

    <div class="comp-result-pill">
      <span>{competition.award}</span>
      {
        competition.score !== undefined && (
          <strong>
            {competition.score}/{competition.maxScore}
          </strong>
        )
      }
    </div>
  </div>

  {
    breakdownItems.length > 0 && (
      <div class="comp-scores-bar">
        {breakdownItems.map((item) => (
          <div class="score-cell">
            <span class="score-label">{item.label}</span>
            <strong class="score-val">
              {item.val}/{item.max}
            </strong>
          </div>
        ))}
      </div>
    )
  }

  {
    (competition.judgeConsensus || competition.recipeImprovements) && (
      <div class="comp-notes">
        {competition.judgeConsensus && (
          <p>
            <strong>Judge Consensus:</strong> {competition.judgeConsensus}
          </p>
        )}
        {competition.recipeImprovements && (
          <p class="comp-next">
            <strong>Next Iteration:</strong> {competition.recipeImprovements}
          </p>
        )}
      </div>
    )
  }
</section>

<style>
  .comp-sheet {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 0 0 2rem;
    background-color: var(--bg);
  }

  .comp-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .comp-title {
    font-size: 1.1rem;
    margin-top: 0.25rem;
  }

  .comp-result-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--forest);
    background-color: var(--forest-tint);
    color: var(--forest);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .comp-scores-bar {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-subtle);
    margin-bottom: 1rem;
  }

  .score-cell {
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .score-cell + .score-cell {
    border-left: 1px solid var(--border);
  }

  .score-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .score-val {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

  .comp-notes {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .comp-next {
    margin-top: 0.45rem;
  }

  @media (max-width: 640px) {
    .comp-scores-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
