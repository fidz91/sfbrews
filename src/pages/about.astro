---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveAboutHeroImage } from '../utils/images';
import { getHalftoneImage } from '../utils/halftone';

const aboutHeroImage = resolveAboutHeroImage();
const aboutHeroHalftone = await getHalftoneImage(aboutHeroImage);
---

<BaseLayout
  title="About — SFBrews"
  description="About SFBrews, our homebrewing setup, and brewing notes."
>
  <div class="container page-wrap">
    <div class="reading-container">
      <header class="page-head">
        <span class="mono-label page-kicker">Brewhouse &amp; Notes</span>
        <h1>About S.F.Brews</h1>
        <p class="page-lead">
          Welcome to <strong>S.F.Brews</strong>—a personal homebrewing journal documenting recipes, brewday logs, experiments, and competition results.
        </p>
      </header>

      {
        aboutHeroImage && (
          <figure class="about-hero-figure zine-media">
            <img class="zine-img" src={aboutHeroImage} alt="S.F.Brews Brewhouse" />
            {
              aboutHeroHalftone && (
                <img class="zine-halftone-img" src={aboutHeroHalftone} alt="" aria-hidden="true" />
              )
            }
          </figure>
        )
      }

      <div class="prose">
        <h2>The Brewhouse</h2>
        <p>
          <em>Update this section in <code>src/pages/about.astro</code> with your equipment details, batch sizes, and brewing philosophy:</em>
        </p>
        <ul>
          <li><strong>System &amp; Batch Size:</strong> KegLand BrewZilla Gen 4.1.1 all-in-one brewing system [add your typical batch volume &amp; accessories]</li>
          <li><strong>Fermentation:</strong> [Add your fermenters and temperature control setup]</li>
          <li><strong>Dispense &amp; Packaging:</strong> [Add your kegging / tap or bottling setup]</li>
        </ul>

        <h2>Adding &amp; Updating Posts</h2>
        <p>
          Every writeup lives as a Markdown file in <code>src/content/posts/</code>, with starter templates available in <code>_templates/</code>. Set <code>hidden: true</code> (or a future <code>publishAfter</code> date) in the frontmatter to keep drafts or upcoming competition entries hidden until you are ready to publish.
        </p>

        <h2>Changing Images</h2>
        <p>
          You can change any image on the site either by <strong>uploading a file into the private <code>_images/</code> folder</strong> or by <strong>referencing a URL</strong>:
        </p>
        <ul>
          <li><strong>Drop into <code>_images/</code>:</strong> Upload any photo into <code>_images/</code> (for example, <code>_images/hero.jpg</code> for the homepage banner or <code>_images/dark-rye-saison.jpg</code> matching a post filename) and it will be picked up automatically—or reference the filename in <code>heroImage: "my-photo.jpg"</code>.</li>
          <li><strong>Central Image Config:</strong> Edit <code>src/data/images.ts</code> to swap the homepage banner, category defaults, or individual post images in one place using either a filename in <code>_images/</code> or a full <code>https://...</code> URL.</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 2.5rem;
  }

  .page-head {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-kicker {
    display: block;
    color: var(--forest);
    margin-bottom: 0.4rem;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 3.8vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.55rem;
  }

  .page-lead {
    color: var(--ink-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .about-hero-figure {
    margin: 0 0 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .about-hero-figure img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }
</style>
