---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import CompetitionScoreCard from '../../components/CompetitionScoreCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, isPostVisible, withBase } from '../../utils/srm';
import {
  getPrivateImageClientMap,
  resolvePostGallery,
  resolvePostHeroImage,
} from '../../utils/images';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(isPostVisible);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title,
  subtitle,
  description,
  pubDate,
  category,
  batchNumber,
  beerStyle,
  readingTime,
  heroCaption,
  recipe,
  experiment,
  competition,
} = post.data;

const resolvedHeroImage = resolvePostHeroImage(post);
const galleryItems = resolvePostGallery(post);
const privateImageMapJson = JSON.stringify(getPrivateImageClientMap());

const meta = CATEGORY_META[category];
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const morePosts = (await getCollection('posts'))
  .filter((p) => isPostVisible(p) && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={`${title} — SFBrews`} description={description}>
  <article class="article outer">
    <header class="article-header canvas">
      <a href={withBase(`/journal?category=${category}`)} class="primary-tag">
        {meta.plural}
      </a>

      <h1 class="article-title">{title}</h1>

      {subtitle && <p class="article-excerpt">{subtitle}</p>}

      <div class="article-byline">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && <span>&bull; {readingTime}</span>}
        {batchNumber && <span>&bull; {batchNumber}</span>}
        {beerStyle && <span>&bull; {beerStyle}</span>}
      </div>
    </header>

    {
      resolvedHeroImage && (
        <figure class="article-image inner">
          <img src={resolvedHeroImage} alt={title} transition:name={`post-img-${post.slug}`} />
          {heroCaption && <figcaption class="article-image-caption">{heroCaption}</figcaption>}
        </figure>
      )
    }

    <div class="article-content canvas" data-private-images={privateImageMapJson}>
      {competition && <CompetitionScoreCard competition={competition} />}
      {experiment && <ExperimentCard experiment={experiment} title={title} />}

      <div class="prose">
        <Content />
      </div>

      {
        galleryItems.length > 0 && (
          <section class="post-gallery" aria-label="Brewday & Recipe Photos">
            <div class="post-gallery-grid">
              {galleryItems.map((item) => (
                <figure class="post-gallery-item">
                  <img src={item.src} alt={item.alt} loading="lazy" />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        recipe && (
          <RecipeCard
            recipe={recipe}
            beerName={title}
            beerStyle={beerStyle}
            batchNumber={batchNumber}
          />
        )
      }
    </div>
  </article>

  <section class="read-more-section outer">
    <div class="inner">
      <h3 class="read-more-heading">More from SFBrews</h3>
      <div class="read-more-grid">
        {morePosts.map((related) => <PostCard post={related} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function resolveInlinePrivateImages() {
    const container = document.querySelector<HTMLElement>('.article-content[data-private-images]');
    if (!container) return;
    try {
      const map: Record<string, string> = JSON.parse(container.dataset.privateImages || '{}');
      container.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        const rawSrc = img.getAttribute('src') || '';
        if (!rawSrc || /^(https?:)?\/\//i.test(rawSrc) || rawSrc.startsWith('data:')) return;
        const clean = rawSrc.replace(/\\/g, '/').replace(/^\.\//, '').replace(/^\//, '').toLowerCase();
        const fileName = clean.split('/').pop() || '';
        const resolved = map[clean] || map[fileName];
        if (resolved) {
          img.src = resolved;
        }
      });
    } catch {
      // Ignore malformed JSON
    }
  }
  document.addEventListener('astro:page-load', resolveInlinePrivateImages);
</script>

<style>
  .article {
    padding-top: 4.5rem;
  }

  .article-header {
    margin-bottom: 3rem;
  }

  .article-title {
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-main);
    margin-bottom: 1.15rem;
  }

  .article-excerpt {
    font-size: clamp(1.08rem, 2vw, 1.26rem);
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 1.65rem;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-muted);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .article-image {
    max-width: 980px;
    margin: 0 auto 3.5rem;
  }

  .article-image img {
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    border-radius: var(--md-sys-shape-corner-large);
  }

  .article-image-caption {
    margin-top: 0.65rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  .post-gallery {
    margin: 2.5rem 0;
  }

  .post-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .post-gallery-item {
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--border);
    border-radius: var(--md-sys-shape-corner-large);
    overflow: hidden;
  }

  .post-gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .post-gallery-item figcaption {
    padding: 0.65rem 0.9rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .read-more-section {
    margin-top: 6.5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--border);
  }

  .read-more-heading {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--palette-hop-green);
    margin-bottom: 2.5rem;
  }

  .read-more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 960px) {
    .read-more-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 2.75rem;
    }

    .article-image {
      margin-bottom: 2.5rem;
    }

    .read-more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
