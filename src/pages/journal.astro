---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Archive & Search — SFBrews"
  description="Browse and search all brewdays, recipes, experiments, competitions, and news."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="md-page-head md-reveal">
        <div class="page-head-top">
          <div>
            <span class="page-kicker">Brewhouse Library</span>
            <h1>Archive &amp; Search</h1>
          </div>
          <span class="results-counter" id="results-count">{allPosts.length} entries</span>
        </div>

        <div class="filter-bar">
          <!-- Material 3 Search Bar -->
          <div class="md-search-bar">
            <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
            <input
              type="search"
              id="journal-search"
              placeholder="Search recipes, hops, malts, yeast, or brewdays..."
              aria-label="Search posts"
            />
            <button
              type="button"
              id="clear-search-btn"
              class="md-icon-btn clear-btn"
              aria-label="Clear search"
              hidden
            >
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
          </div>

          <!-- Material 3 Filter Chips -->
          <div class="cat-pills" role="tablist" aria-label="Filter by post category">
            <button class="cat-btn active" data-cat="all" role="tab" aria-selected="true">
              <span class="material-symbols-outlined chip-check" aria-hidden="true">check</span>
              <span>All Entries</span>
            </button>
            <button class="cat-btn" data-cat="recipe" role="tab" aria-selected="false">
              <span class="material-symbols-outlined chip-check" aria-hidden="true">check</span>
              <span>Recipes &amp; Brewdays</span>
            </button>
            <button class="cat-btn" data-cat="experiment" role="tab" aria-selected="false">
              <span class="material-symbols-outlined chip-check" aria-hidden="true">check</span>
              <span>Experiments</span>
            </button>
            <button class="cat-btn" data-cat="competition" role="tab" aria-selected="false">
              <span class="material-symbols-outlined chip-check" aria-hidden="true">check</span>
              <span>Competitions</span>
            </button>
            <button class="cat-btn" data-cat="news" role="tab" aria-selected="false">
              <span class="material-symbols-outlined chip-check" aria-hidden="true">check</span>
              <span>News</span>
            </button>
          </div>
        </div>
      </header>

      <div class="post-feed" id="journal-grid">
        {allPosts.map((post) => <PostCard post={post} />)}
      </div>

      <div id="empty-state" class="md-empty-state" hidden>
        <span class="material-symbols-outlined empty-icon" aria-hidden="true">search_off</span>
        <h3>No matching articles found</h3>
        <p>Try clearing your search query or selecting a different category chip.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initJournalFilters() {
    const searchInput = document.getElementById('journal-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('#journal-grid .post-card');
    const emptyState = document.getElementById('empty-state');
    const resultsCount = document.getElementById('results-count');

    if (!cards.length) return;

    let activeCat = 'all';
    let searchQuery = '';

    function applyFilters(animate = false) {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const text = card.dataset.search || '';
        const matchesCat =
          activeCat === 'all' ||
          cat === activeCat ||
          (activeCat === 'recipe' && (cat === 'recipe' || cat === 'brewday'));
        const matchesSearch = !searchQuery || text.includes(searchQuery.toLowerCase());

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
          if (animate) {
            card.animate(
              [
                { opacity: 0, transform: 'scale(0.96) translateY(8px)' },
                { opacity: 1, transform: 'scale(1) translateY(0)' },
              ],
              { duration: 240, easing: 'cubic-bezier(0.05, 0.7, 0.1, 1)' }
            );
          }
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) emptyState.hidden = visible > 0;
      if (resultsCount) {
        resultsCount.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
      }
      if (clearBtn) {
        clearBtn.hidden = !searchQuery;
      }
    }

    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    const urlQuery = params.get('q');

    if (urlCat) {
      activeCat = urlCat === 'brewday' ? 'recipe' : urlCat;
      catButtons.forEach((btn) => {
        const isMatch = btn.dataset.cat === activeCat;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', String(isMatch));
      });
    }
    if (urlQuery && searchInput) {
      searchQuery = urlQuery;
      searchInput.value = urlQuery;
    }
    applyFilters(false);

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applyFilters(true);
    });

    clearBtn?.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      searchQuery = '';
      searchInput.focus();
      applyFilters(true);
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.cat || 'all';
        catButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        applyFilters(true);
      });
    });
  }

  document.addEventListener('astro:page-load', initJournalFilters);
</script>

<style>
  .page-wrap {
    padding-top: 2rem;
  }

  .md-page-head {
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: clamp(1.35rem, 3vw, 2.25rem);
    margin-bottom: 2.25rem;
    box-shadow: var(--md-sys-elevation-1);
  }

  .page-head-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.35rem;
  }

  .page-kicker {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--md-sys-color-primary);
    margin-bottom: 0.25rem;
  }

  .md-page-head h1 {
    font-size: clamp(1.8rem, 4vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--md-sys-color-on-surface);
  }

  .results-counter {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Material 3 Search Bar */
  .md-search-bar {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 620px;
    height: 52px;
    background-color: var(--md-sys-color-surface-container-highest);
    border: 1.5px solid transparent;
    border-radius: var(--md-sys-shape-corner-full);
    padding: 0 0.5rem 0 1.1rem;
    transition:
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .md-search-bar:focus-within {
    background-color: var(--md-sys-color-surface-container-lowest);
    border-color: var(--md-sys-color-primary);
    box-shadow: var(--md-sys-elevation-2);
  }

  .search-icon {
    color: var(--md-sys-color-on-surface-variant);
    margin-right: 0.65rem;
    flex-shrink: 0;
  }

  #journal-search {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.96rem;
    color: var(--md-sys-color-on-surface);
    outline: none;
  }

  #journal-search::placeholder {
    color: var(--md-sys-color-outline);
  }

  .clear-btn {
    width: 36px;
    height: 36px;
  }

  /* Material 3 Filter Chips */
  .cat-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 38px;
    padding: 0 1rem;
    border-radius: var(--md-sys-shape-corner-small);
    border: 1px solid var(--md-sys-color-outline);
    background-color: var(--md-sys-color-surface-container-lowest);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition:
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      transform var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-spring);
  }

  .cat-btn:hover {
    background-color: var(--md-state-hover);
  }

  .cat-btn:active {
    transform: scale(0.96);
  }

  .chip-check {
    font-size: 16px;
    width: 0;
    opacity: 0;
    overflow: hidden;
    transform: scale(0.5);
    transition:
      width var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
      opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-spring);
  }

  .cat-btn.active {
    background-color: var(--md-sys-color-secondary-container);
    border-color: transparent;
    color: var(--md-sys-color-on-secondary-container);
  }

  .cat-btn.active .chip-check {
    width: 18px;
    opacity: 1;
    transform: scale(1);
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .md-empty-state {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px dashed var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  .empty-icon {
    font-size: 42px;
    color: var(--md-sys-color-outline);
    margin-bottom: 0.75rem;
  }

  .md-empty-state h3 {
    font-size: 1.2rem;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 960px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.35rem;
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 1.25rem;
    }

    .cat-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .cat-pills::-webkit-scrollbar {
      display: none;
    }

    .cat-btn {
      flex-shrink: 0;
    }

    .post-feed {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
