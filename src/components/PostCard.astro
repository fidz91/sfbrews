---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META, withBase } from '../utils/srm';
import { resolvePostHeroImage } from '../utils/images';
import { getHalftoneImage } from '../utils/halftone';

interface Props {
  post: CollectionEntry<'posts'>;
  large?: boolean;
}

const { post, large = false } = Astro.props;
const {
  title,
  description,
  pubDate,
  category,
  tags,
  beerStyle,
  batchNumber,
  recipe,
} = post.data;

const resolvedHeroImage = resolvePostHeroImage(post);
const halftoneHeroImage = await getHalftoneImage(resolvedHeroImage);
const meta = CATEGORY_META[category];

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article
  class="post-card"
  data-category={category}
  data-tags={tags.join(',').toLowerCase()}
  data-search={`${title} ${description} ${beerStyle || ''} ${batchNumber || ''} ${tags.join(' ')}`.toLowerCase()}
>
  {
    resolvedHeroImage && (
      <a class="post-card-media zine-media" href={withBase(`/posts/${post.slug}`)} tabindex="-1" aria-hidden="true">
        <img
          class="post-card-img zine-img"
          src={resolvedHeroImage}
          alt={title}
          loading={large ? 'eager' : 'lazy'}
          transition:name={`post-img-${post.slug}`}
        />
        {
          halftoneHeroImage && (
            <img
              class="zine-halftone-img"
              src={halftoneHeroImage}
              alt=""
              aria-hidden="true"
              loading={large ? 'eager' : 'lazy'}
            />
          )
        }
      </a>
    )
  }

  <div class="post-card-body">
    <div class="post-card-meta">
      <span class="post-card-cat">{meta.label}</span>
      <span class="meta-dot">&middot;</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {
        batchNumber && (
          <>
            <span class="meta-dot">&middot;</span>
            <span>{batchNumber}</span>
          </>
        )
      }
    </div>

    <a class="post-card-title-link" href={withBase(`/posts/${post.slug}`)}>
      <h2 class="post-card-title" transition:name={`post-title-${post.slug}`}>{title}</h2>
    </a>

    <p class="post-card-excerpt">{description}</p>

    {
      recipe && (
        <p class="post-card-specs">
          {recipe.abv.toFixed(1)}% ABV &middot; {recipe.ibu} IBU &middot; {recipe.srm} SRM
        </p>
      )
    }
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--forest);
  }

  .post-card-media {
    display: block;
    aspect-ratio: 16 / 10;
    width: 100%;
    border-bottom: 1px solid var(--border);
  }

  .post-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card:hover .post-card-img {
    transform: scale(1.03);
  }

  .post-card-body {
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .post-card-cat {
    color: var(--forest);
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.28;
    color: var(--ink);
  }

  .post-card:hover .post-card-title {
    color: var(--forest);
  }

  .post-card-excerpt {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-specs {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-muted);
    letter-spacing: 0.03em;
  }
</style>
