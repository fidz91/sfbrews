---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import CompetitionScoreCard from '../../components/CompetitionScoreCard.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, isPostVisible, withBase } from '../../utils/srm';
import {
  resolvePostHeroImage,
  resolvePostGallery,
  buildPrivateImageLookup,
} from '../../utils/images';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(isPostVisible);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  category,
  beerStyle,
  batchNumber,
  readingTime,
  heroCaption,
  recipe,
  competition,
  experiment,
} = post.data;

const resolvedHeroImage = resolvePostHeroImage(post);
const galleryItems = resolvePostGallery(post);
const privateImageMapJson = JSON.stringify(buildPrivateImageLookup());

const meta = CATEGORY_META[category];

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const morePosts = (await getCollection('posts'))
  .filter((p) => isPostVisible(p) && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title={`${title} — SFBrews`} description={description} ogImage={resolvedHeroImage}>
  <article class="container post-article">
    <div class="reading-container">
      <a href={withBase('/')} class="back-link">&larr; Back to Journal</a>

      <header class="post-header">
        <div class="post-meta-line">
          <a href={withBase(`/?category=${category}`)} class="post-cat-link">
            {meta.label}
          </a>
          <span>&middot;</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {
            beerStyle && (
              <>
                <span>&middot;</span>
                <span>{beerStyle}</span>
              </>
            )
          }
          {
            batchNumber && (
              <>
                <span>&middot;</span>
                <span>{batchNumber}</span>
              </>
            )
          }
          {
            readingTime && (
              <>
                <span>&middot;</span>
                <span>{readingTime}</span>
              </>
            )
          }
          {
            updatedDate && (
              <>
                <span>&middot;</span>
                <span>
                  Updated{' '}
                  {updatedDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </>
            )
          }
        </div>

        <h1 class="post-title" transition:name={`post-title-${post.slug}`}>
          {title}
        </h1>
        {subtitle && <p class="post-subtitle">{subtitle}</p>}
        <p class="post-excerpt">{description}</p>
      </header>

      {
        resolvedHeroImage && (
          <figure class="post-hero-figure">
            <div class="threshold-media post-hero-frame">
              <img
                class="threshold-img"
                src={resolvedHeroImage}
                alt={title}
                transition:name={`post-img-${post.slug}`}
              />
            </div>
            {heroCaption && <figcaption class="post-hero-caption">{heroCaption}</figcaption>}
          </figure>
        )
      }

      <div class="post-body" data-private-images={privateImageMapJson}>
        {competition && <CompetitionScoreCard competition={competition} />}
        {experiment && <ExperimentCard experiment={experiment} title={title} />}

        {
          recipe && (
            <RecipeCard
              recipe={recipe}
              beerName={title}
              beerStyle={beerStyle}
              batchNumber={batchNumber}
            />
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          galleryItems.length > 0 && (
            <section class="post-gallery" aria-label="Brewday & Recipe Photos">
              <div class="post-gallery-grid">
                {galleryItems.map((item) => (
                  <figure class="post-gallery-item">
                    <img src={item.src} alt={item.alt} loading="lazy" />
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </article>

  {
    morePosts.length > 0 && (
      <section class="container read-more-section">
        <div class="reading-container">
          <h3 class="read-more-heading">More from S.F.Brews</h3>
          <div class="read-more-grid">
            {morePosts.map((related) => (
              <PostCard post={related} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  function resolveInlinePrivateImages() {
    const container = document.querySelector<HTMLElement>('.post-body[data-private-images]');
    if (!container) return;
    try {
      const map: Record<string, string> = JSON.parse(container.dataset.privateImages || '{}');
      container.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        const rawSrc = img.getAttribute('src') || '';
        if (!rawSrc || /^(https?:)?\/\//i.test(rawSrc) || rawSrc.startsWith('data:')) return;
        const clean = rawSrc.replace(/\\/g, '/').replace(/^\.\//, '').replace(/^\//, '').toLowerCase();
        const fileName = clean.split('/').pop() || '';
        const resolved = map[clean] || map[fileName];
        if (resolved) {
          img.src = resolved;
        }
      });
    } catch {
      // Ignore malformed JSON
    }
  }
  document.addEventListener('astro:page-load', resolveInlinePrivateImages);
</script>

<style>
  .post-article {
    padding-top: 2.25rem;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--forest);
  }

  .post-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
  }

  .post-cat-link {
    color: var(--forest);
  }

  .post-cat-link:hover {
    text-decoration: underline;
  }

  .post-title {
    font-size: clamp(1.9rem, 4vw, 2.65rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .post-subtitle {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.65rem;
  }

  .post-excerpt {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .post-hero-figure {
    margin-bottom: 2.25rem;
  }

  .post-hero-frame {
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .post-hero-frame img {
    width: 100%;
    max-height: 440px;
    object-fit: cover;
  }

  .post-hero-caption {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-muted);
    text-align: center;
  }

  .post-gallery {
    margin: 2.25rem 0;
  }

  .post-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .post-gallery-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .post-gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .post-gallery-item figcaption {
    padding: 0.55rem 0.8rem;
    font-size: 0.82rem;
    color: var(--ink-secondary);
    border-top: 1px solid var(--border);
  }

  .read-more-section {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .read-more-heading {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--forest);
    margin-bottom: 1.25rem;
  }

  .read-more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .read-more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
