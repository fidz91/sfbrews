---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPETITION_RECORDS, isCompetitionVisible } from '../data/competitions';
import { srmToHex, withBase } from '../utils/srm';

const visibleCompetitions = COMPETITION_RECORDS.filter(isCompetitionVisible);
---

<BaseLayout
  title="Competition Results & BJCP Scoresheets — SFBrews"
  description="Homebrewing competition entries, BJCP scoresheets, and judge feedback."
>
  <div class="outer page-wrap">
    <div class="canvas prose">
      <span class="page-eyebrow">BJCP Scoresheet Archive</span>
      <h1>Competitions &amp; Scoresheets</h1>
      <p>
        Regional and national homebrew competition entries, BJCP scoresheet breakdowns, and recipe iteration notes.
      </p>

      {
        visibleCompetitions.length > 0 ? (
          <>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Competition</th>
                    <th>Beer &amp; Style</th>
                    <th>Score</th>
                    <th>Result</th>
                  </tr>
                </thead>
                <tbody>
                  {visibleCompetitions.map((rec) => (
                    <tr>
                      <td class="nowrap">{rec.date}</td>
                      <td>
                        {rec.postSlug ? (
                          <a href={withBase(`/posts/${rec.postSlug}`)}>{rec.competitionName}</a>
                        ) : (
                          rec.competitionName
                        )}
                      </td>
                      <td>
                        <span class="srm-dot" style={`background-color: ${srmToHex(rec.srm)};`} />{' '}
                        {rec.recipeSlug ? (
                          <a href={withBase(`/posts/${rec.recipeSlug}`)}>
                            <strong>{rec.beerName}</strong>
                          </a>
                        ) : rec.postSlug ? (
                          <a href={withBase(`/posts/${rec.postSlug}`)}>
                            <strong>{rec.beerName}</strong>
                          </a>
                        ) : (
                          <strong>{rec.beerName}</strong>
                        )}{' '}
                        <span class="muted">
                          ({rec.bjcpCategory} {rec.bjcpStyleName})
                        </span>
                      </td>
                      <td class="nowrap">
                        {rec.score !== undefined ? `${rec.score} / ${rec.maxScore}` : 'Pending'}
                      </td>
                      <td class="nowrap">
                        <strong>{rec.award}</strong>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <h2>Judge Notes &amp; Recipe Adjustments</h2>
            {visibleCompetitions.map((rec) => (
              <div class="comp-item">
                <h3>
                  {rec.beerName} — {rec.award}
                  {rec.score !== undefined ? ` (${rec.score}/${rec.maxScore})` : ''}
                </h3>
                <p class="comp-meta">
                  {rec.competitionName} ({rec.date})
                  {rec.scoresBreakdown && (
                    <>
                      {' '}
                      &bull; Aroma {rec.scoresBreakdown.aroma}/12, Appearance{' '}
                      {rec.scoresBreakdown.appearance}/3, Flavor {rec.scoresBreakdown.flavor}/20,
                      Mouthfeel {rec.scoresBreakdown.mouthfeel}/5, Overall{' '}
                      {rec.scoresBreakdown.overall}/10
                    </>
                  )}
                </p>
                <p>
                  <strong>Judge Summary:</strong> “{rec.judgeSummary}”
                </p>
                <p>
                  <strong>Next Iteration:</strong> {rec.nextIterationPlan}
                </p>
              </div>
            ))}
          </>
        ) : (
          <div class="comp-empty-notice">
            <p>
              <strong>Upcoming competition entries are currently in progress.</strong>
            </p>
            <p class="muted">
              Full competition writeups, BJCP scoresheets, and judge feedback will appear here once judging concludes.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--md-sys-color-primary);
    display: block;
    margin-bottom: 0.35rem;
  }

  .page-wrap h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    margin-top: 0;
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nowrap {
    white-space: nowrap;
  }

  .muted {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.92rem;
  }

  .comp-item {
    padding: 1.75rem;
    margin-bottom: 1rem;
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    box-shadow: var(--md-sys-elevation-1);
  }

  .comp-item h3 {
    margin-top: 0;
  }

  .comp-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--md-sys-color-outline);
    margin-bottom: 0.9rem;
  }

  .comp-empty-notice {
    margin-top: 2rem;
    padding: 2rem 2.25rem;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .comp-empty-notice p {
    margin: 0.4rem 0;
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2rem;
    }
  }
</style>
