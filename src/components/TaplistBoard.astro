---
import { ACTIVE_TAPS, ACTIVE_FERMENTERS, UPCOMING_BREWS } from '../data/taplist';
import { srmToHex, withBase } from '../utils/srm';
---

<section class="m3-pipeline-card" id="taplist" aria-label="Currently On Tap, Fermenting, and Upcoming">
  <div class="m3-pipeline-header">
    <div class="m3-pipeline-title-row">
      <span class="m3-live-ping">
        <span class="m3-live-ping-ring"></span>
        <span class="m3-live-ping-dot"></span>
      </span>
      <h2 class="m3-pipeline-title">Active Pipeline Telemetry</h2>
    </div>
    <span class="m3-pipeline-badge">Live Status</span>
  </div>

  <div class="m3-pipeline-list">
    <!-- 1. Currently On Tap -->
    {
      ACTIVE_TAPS.length > 0 ? (
        ACTIVE_TAPS.map((tap, idx) => {
          const Tag = tap.postSlug ? 'a' : 'div';
          const href = tap.postSlug ? withBase(`/posts/${tap.postSlug}`) : undefined;
          return (
            <Tag href={href} class:list={['m3-pipeline-item', 'is-tap', { 'is-link': !!tap.postSlug }]}>
              <div class="m3-pipeline-item-left">
                <span class="m3-pipeline-icon tap">
                  <span class="material-symbols-outlined filled">sports_bar</span>
                </span>
                <div class="m3-pipeline-item-body">
                  <div class="m3-pipeline-meta-row">
                    <span class="m3-pipeline-role tap">
                      Tap #{tap.tapNumber ?? idx + 1} &bull; {tap.tapLabel || 'On Tap'}
                    </span>
                    {tap.bjcpCode && <span class="m3-bjcp-pill tap">{tap.bjcpCode}</span>}
                  </div>
                  <p class="m3-pipeline-name">{tap.name}</p>
                  <p class="m3-pipeline-sub">
                    {tap.style}
                    {tap.abv !== undefined ? ` · ${tap.abv.toFixed(1)}% ABV` : ''}
                    {tap.ibu !== undefined ? ` · ${tap.ibu} IBU` : ''}
                  </p>
                </div>
              </div>

              <div class="m3-pipeline-item-right">
                <span
                  class="m3-srm-pill"
                  title={`${tap.srm} SRM`}
                >
                  <span class="srm-dot" style={`background-color: ${srmToHex(tap.srm)};`} />
                  <span>{tap.srm} SRM</span>
                </span>
                {tap.postSlug && (
                  <span class="m3-pipeline-link-hint">
                    Recipe <span class="material-symbols-outlined">chevron_right</span>
                  </span>
                )}
              </div>
            </Tag>
          );
        })
      ) : (
        <div class="m3-pipeline-item is-empty">
          <div class="m3-pipeline-item-left">
            <span class="m3-pipeline-icon muted">
              <span class="material-symbols-outlined">sports_bar</span>
            </span>
            <div class="m3-pipeline-item-body">
              <span class="m3-pipeline-role muted">On Tap</span>
              <p class="m3-pipeline-sub">No active taps right now</p>
            </div>
          </div>
        </div>
      )
    }

    <!-- 2. Fermenting -->
    {
      ACTIVE_FERMENTERS.length > 0 ? (
        ACTIVE_FERMENTERS.map((fv) => {
          const Tag = fv.postSlug ? 'a' : 'div';
          const href = fv.postSlug ? withBase(`/posts/${fv.postSlug}`) : undefined;
          return (
            <Tag href={href} class:list={['m3-pipeline-item', 'is-fv', { 'is-link': !!fv.postSlug }]}>
              <div class="m3-pipeline-item-left">
                <span class="m3-pipeline-icon fv">
                  <span class="material-symbols-outlined filled">bubble_chart</span>
                </span>
                <div class="m3-pipeline-item-body">
                  <div class="m3-pipeline-meta-row">
                    <span class="m3-pipeline-role fv">{fv.vessel || 'Fermenter'} &bull; {fv.stage}</span>
                  </div>
                  <p class="m3-pipeline-name">{fv.name}</p>
                  <p class="m3-pipeline-sub">
                    {fv.style}
                    {fv.currentGravity !== undefined ? ` · ${fv.currentGravity.toFixed(3)} SG` : ''}
                  </p>
                </div>
              </div>

              <div class="m3-pipeline-item-right">
                {fv.currentTemp && <span class="m3-fv-temp">{fv.currentTemp}</span>}
                <span class="m3-srm-pill" title={`${fv.srm} SRM`}>
                  <span class="srm-dot" style={`background-color: ${srmToHex(fv.srm)};`} />
                  <span>{fv.srm} SRM</span>
                </span>
              </div>
            </Tag>
          );
        })
      ) : (
        <div class="m3-pipeline-item is-fv-empty">
          <div class="m3-pipeline-item-left">
            <span class="m3-pipeline-icon fv">
              <span class="material-symbols-outlined">science</span>
            </span>
            <div class="m3-pipeline-item-body">
              <span class="m3-pipeline-role fv">In The Fermenter</span>
              <p class="m3-pipeline-sub">Fermenters currently empty — conditioning &amp; planning next brewday</p>
            </div>
          </div>
        </div>
      )
    }

    <!-- 3. Upcoming Brews -->
    {
      UPCOMING_BREWS.map((up, idx) => {
        const Tag = up.postSlug ? 'a' : 'div';
        const href = up.postSlug ? withBase(`/posts/${up.postSlug}`) : undefined;
        return (
          <Tag href={href} class:list={['m3-pipeline-item', 'is-planned', { 'is-link': !!up.postSlug }]}>
            <div class="m3-pipeline-item-left">
              <span class="m3-pipeline-icon planned">
                <span class="material-symbols-outlined">
                  {idx === 0 ? 'calendar_today' : 'schedule'}
                </span>
              </span>
              <div class="m3-pipeline-item-body">
                <div class="m3-pipeline-meta-row">
                  <span class="m3-pipeline-role planned">
                    {idx === 0 ? 'Up Next' : 'Queued'} &bull; Planned Brew
                  </span>
                </div>
                <p class="m3-pipeline-name sm">{up.name}</p>
                <p class="m3-pipeline-sub">{up.style}</p>
              </div>
            </div>

            <div class="m3-pipeline-item-right">
              <span class="m3-srm-pill" title={`${up.srm} SRM`}>
                <span class="srm-dot" style={`background-color: ${srmToHex(up.srm)};`} />
                <span>{up.srm} SRM</span>
              </span>
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .m3-pipeline-card {
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 65%, transparent);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 1.25rem;
    box-shadow: var(--md-sys-elevation-1);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .m3-pipeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.25rem 0.25rem;
  }

  .m3-pipeline-title-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .m3-live-ping {
    position: relative;
    display: inline-flex;
    width: 10px;
    height: 10px;
  }

  .m3-live-ping-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: var(--md-sys-color-primary);
    opacity: 0.65;
    animation: pulse-beacon 2s infinite ease-in-out;
  }

  .m3-live-ping-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--md-sys-color-primary);
  }

  .m3-pipeline-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .m3-pipeline-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface-variant);
  }

  .m3-pipeline-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .m3-pipeline-item {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 55%, transparent);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .m3-pipeline-item.is-planned {
    background-color: color-mix(
      in srgb,
      var(--md-sys-color-surface-container-lowest) 70%,
      var(--md-sys-color-surface-container-low)
    );
    padding: 0.72rem 0.95rem;
  }

  .m3-pipeline-item.is-link:hover {
    border-color: var(--md-sys-color-primary);
    box-shadow: var(--md-sys-elevation-1);
    transform: translateY(-1px);
  }

  .m3-pipeline-item-left {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    flex: 1;
  }

  .m3-pipeline-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .m3-pipeline-icon .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .m3-pipeline-icon.tap {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .m3-pipeline-icon.fv {
    background-color: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-primary);
  }

  .m3-pipeline-icon.planned,
  .m3-pipeline-icon.muted {
    background-color: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
  }

  .m3-pipeline-item-body {
    min-width: 0;
    flex: 1;
  }

  .m3-pipeline-meta-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .m3-pipeline-role {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .m3-pipeline-role.tap {
    color: var(--md-sys-color-primary);
  }

  .m3-pipeline-role.fv {
    color: var(--md-sys-color-secondary);
  }

  .m3-pipeline-role.planned,
  .m3-pipeline-role.muted {
    color: var(--md-sys-color-outline);
  }

  .m3-bjcp-pill {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);
    color: var(--md-sys-color-primary);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent);
  }

  .m3-pipeline-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    margin: 0.12rem 0 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .m3-pipeline-name.sm {
    font-size: 0.88rem;
  }

  .m3-pipeline-sub {
    font-size: 0.76rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0.1rem 0 0;
    line-height: 1.35;
  }

  .m3-pipeline-item-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .m3-srm-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 60%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
  }

  .m3-fv-temp {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--md-sys-color-secondary);
  }

  .m3-pipeline-link-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--md-sys-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .m3-pipeline-link-hint .material-symbols-outlined {
    font-size: 0.9rem;
  }
</style>
