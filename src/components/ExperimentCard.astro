---
interface ExperimentData {
  variableTested: string;
  hypothesis: string;
  controlBatch: string;
  experimentalBatch: string;
  panelSize: string;
  significantResult: boolean;
  pValueSummary: string;
  verdict: string;
}

interface Props {
  experiment: ExperimentData;
  title?: string;
}

const { experiment } = Astro.props;
---

<section class="exp-sheet">
  <div class="exp-head">
    <div>
      <span class="mono-label">Split-Batch Experiment</span>
      <h3 class="exp-title">{experiment.variableTested}</h3>
    </div>

    <span class:list={['sig-badge', { significant: experiment.significantResult }]}>
      {experiment.pValueSummary}
    </span>
  </div>

  <div class="exp-arms">
    <div class="arm-box">
      <span class="mono-label">Control</span>
      <p class="arm-val">{experiment.controlBatch}</p>
    </div>
    <div class="arm-box experimental">
      <span class="mono-label">Experimental</span>
      <p class="arm-val">{experiment.experimentalBatch}</p>
    </div>
  </div>

  <div class="exp-verdict">
    <p><strong>Panel ({experiment.panelSize}):</strong> {experiment.verdict}</p>
  </div>
</section>

<style>
  .exp-sheet {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 0 0 2rem;
    background-color: var(--bg);
  }

  .exp-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .exp-title {
    font-size: 1.1rem;
    margin-top: 0.25rem;
  }

  .sig-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    color: var(--ink-secondary);
    background-color: var(--bg-subtle);
  }

  .sig-badge.significant {
    border-color: var(--forest);
    background-color: var(--forest-tint);
    color: var(--forest);
  }

  .exp-arms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .arm-box {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.8rem 0.95rem;
    background-color: var(--bg-subtle);
  }

  .arm-box.experimental {
    border-color: var(--forest);
    background-color: var(--bg);
  }

  .arm-val {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }

  .exp-verdict {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  @media (max-width: 640px) {
    .exp-arms {
      grid-template-columns: 1fr;
    }
  }
</style>
