---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import CompetitionScoreCard from '../../components/CompetitionScoreCard.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, isPostVisible, withBase } from '../../utils/srm';
import {
  resolvePostHeroImage,
  resolvePostGallery,
  buildPrivateImageLookup,
} from '../../utils/images';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(isPostVisible);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  category,
  beerStyle,
  batchNumber,
  readingTime,
  heroCaption,
  recipe,
  competition,
  experiment,
} = post.data;

const resolvedHeroImage = resolvePostHeroImage(post);
const galleryItems = resolvePostGallery(post);
const privateImageMapJson = JSON.stringify(buildPrivateImageLookup());

const meta = CATEGORY_META[category];

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const morePosts = (await getCollection('posts'))
  .filter((p) => isPostVisible(p) && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={`${title} — SFBrews`} description={description} ogImage={resolvedHeroImage}>
  <article class="article outer">
    <header class="article-header canvas">
      <div class="article-meta-pills">
        <a href={withBase(meta.href)} class:list={['primary-tag', `tag-${category}`]}>
          {meta.label}
        </a>
        {beerStyle && <span class="m3-style-pill">{beerStyle}</span>}
        {batchNumber && <span class="m3-batch-pill">{batchNumber}</span>}
      </div>

      <h1 class="article-title" transition:name={`post-title-${post.slug}`}>
        {title}
      </h1>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
      <p class="article-excerpt">{description}</p>

      <div class="article-byline">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {
          updatedDate && (
            <>
              <span>&bull;</span>
              <span>
                Updated{' '}
                {updatedDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
            </>
          )
        }
        {readingTime && <span>&bull;</span>}
        {readingTime && <span>{readingTime}</span>}
      </div>
    </header>

    {
      resolvedHeroImage && (
        <figure class="article-image inner">
          <img src={resolvedHeroImage} alt={title} transition:name={`post-img-${post.slug}`} />
          {heroCaption && <figcaption class="article-image-caption">{heroCaption}</figcaption>}
        </figure>
      )
    }

    <div class="article-content canvas" data-private-images={privateImageMapJson}>
      {competition && <CompetitionScoreCard competition={competition} />}
      {experiment && <ExperimentCard experiment={experiment} title={title} />}

      {
        recipe && (
          <RecipeCard
            recipe={recipe}
            beerName={title}
            beerStyle={beerStyle}
            batchNumber={batchNumber}
          />
        )
      }

      <div class="prose m3-prose-sheet">
        <Content />
      </div>

      {
        galleryItems.length > 0 && (
          <section class="post-gallery" aria-label="Brewday & Recipe Photos">
            <div class="post-gallery-grid">
              {galleryItems.map((item) => (
                <figure class="post-gallery-item">
                  <img src={item.src} alt={item.alt} loading="lazy" />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  {
    morePosts.length > 0 && (
      <section class="read-more-section outer">
        <div class="inner">
          <h3 class="read-more-heading">More from S.F.Brews</h3>
          <div class="read-more-grid">
            {morePosts.map((related) => (
              <PostCard post={related} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  function resolveInlinePrivateImages() {
    const container = document.querySelector<HTMLElement>('.article-content[data-private-images]');
    if (!container) return;
    try {
      const map: Record<string, string> = JSON.parse(container.dataset.privateImages || '{}');
      container.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        const rawSrc = img.getAttribute('src') || '';
        if (!rawSrc || /^(https?:)?\/\//i.test(rawSrc) || rawSrc.startsWith('data:')) return;
        const clean = rawSrc.replace(/\\/g, '/').replace(/^\.\//, '').replace(/^\//, '').toLowerCase();
        const fileName = clean.split('/').pop() || '';
        const resolved = map[clean] || map[fileName];
        if (resolved) {
          img.src = resolved;
        }
      });
    } catch {
      // Ignore malformed JSON
    }
  }
  document.addEventListener('astro:page-load', resolveInlinePrivateImages);
</script>

<style>
  .article {
    padding-top: 3rem;
  }

  .article-header {
    margin-bottom: 2.25rem;
  }

  .article-meta-pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .m3-style-pill,
  .m3-batch-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .article-title {
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.6rem;
  }

  .article-subtitle {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
    margin-bottom: 0.6rem;
  }

  .article-excerpt {
    font-size: clamp(1.04rem, 1.8vw, 1.18rem);
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 1.35rem;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--md-sys-color-outline);
    padding-top: 1rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .comments-jump-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--md-sys-color-primary);
    font-weight: 600;
  }

  .comments-jump-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .comments-jump-link .material-symbols-outlined {
    font-size: 16px;
  }

  .article-image {
    max-width: 980px;
    margin: 0 auto 2.75rem;
  }

  .article-image img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--md-sys-shape-corner-extra-large);
    border: 1px solid var(--md-sys-color-outline-variant);
    box-shadow: var(--md-sys-elevation-1);
  }

  .article-image-caption {
    margin-top: 0.65rem;
    font-size: 0.85rem;
    color: var(--md-sys-color-outline);
    text-align: center;
  }

  .m3-prose-sheet {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 2.25rem;
    box-shadow: var(--md-sys-elevation-1);
  }

  .m3-prose-sheet :global(> :first-child) {
    margin-top: 0;
  }

  .post-gallery {
    margin: 2.5rem 0;
  }

  .post-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .post-gallery-item {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    overflow: hidden;
  }

  .post-gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .post-gallery-item figcaption {
    padding: 0.65rem 0.9rem;
    font-size: 0.84rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .read-more-section {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .read-more-heading {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--md-sys-color-primary);
    margin-bottom: 1.75rem;
  }

  .read-more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  @media (max-width: 1024px) {
    .read-more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 2rem;
    }

    .m3-prose-sheet {
      padding: 1.4rem;
    }

    .read-more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
