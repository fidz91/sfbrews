---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { withBase } from '../utils/srm';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'S.F.Brews',
  description = 'Homebrewing writeups, recipe formulations, experiments, competitions and brewing notes.',
  currentPath = Astro.url.pathname,
} = Astro.props;

const homeHref = withBase('/');
const navLinks = [
  { href: homeHref, label: 'Home', icon: 'home' },
  { href: withBase('/recipes'), label: 'Recipes & Brewdays', icon: 'menu_book' },
  { href: withBase('/experiments'), label: 'Experiments', icon: 'science' },
  { href: withBase('/competitions'), label: 'Competitions', icon: 'emoji_events' },
  { href: withBase('/journal?category=news'), label: 'News', icon: 'campaign' },
  { href: withBase('/about'), label: 'About', icon: 'info' },
];

const bottomNavLinks = [
  { href: homeHref, label: 'Home', icon: 'home' },
  { href: withBase('/recipes'), label: 'Recipes', icon: 'menu_book' },
  { href: withBase('/experiments'), label: 'Lab', icon: 'science' },
  { href: withBase('/competitions'), label: 'Awards', icon: 'emoji_events' },
  { href: withBase('/journal'), label: 'Archive', icon: 'manage_search' },
];

function checkActive(itemHref: string, path: string): boolean {
  const cleanHref = itemHref.split('?')[0];
  if (cleanHref === homeHref || cleanHref === homeHref.replace(/\/$/, '')) {
    return path === homeHref || path === homeHref.replace(/\/$/, '');
  }
  return path.startsWith(cleanHref);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ViewTransitions />
    <script is:inline>
      function applyTheme() {
        const saved = localStorage.getItem('md-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <!-- Material 3 Top App Bar -->
    <header class="md-top-app-bar outer" id="top-app-bar">
      <div class="md-top-app-bar-inner inner">
        <div class="md-brand-row">
          <a class="md-brand-logo md-ripple-surface" href={homeHref}>
            <span class="md-brand-badge">
              <span class="material-symbols-outlined filled" aria-hidden="true">sports_bar</span>
            </span>
            <span class="md-brand-text">
              <span class="md-brand-title">S.F.Brews</span>
              <span class="md-brand-subtitle">Homebrewing</span>
            </span>
          </a>
        </div>

        <!-- Desktop Navigation Pills -->
        <nav class="md-desktop-nav" aria-label="Primary Navigation">
          <ul class="md-nav-list">
            {
              navLinks.map((item) => {
                const isActive = checkActive(item.href, currentPath);
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={['md-nav-pill', 'md-ripple-surface', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <span class:list={['material-symbols-outlined', 'nav-icon', { filled: isActive }]} aria-hidden="true">
                        {item.icon}
                      </span>
                      <span>{item.label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <!-- App Bar Actions -->
        <div class="md-app-bar-actions">
          <a
            href={withBase('/journal')}
            class="md-icon-btn"
            aria-label="Search & Archive"
            title="Search & Archive"
          >
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
          </a>

          <button
            type="button"
            class="md-icon-btn"
            id="theme-toggle-btn"
            aria-label="Toggle dark or light theme"
            title="Toggle color theme"
          >
            <span class="material-symbols-outlined theme-icon-light" aria-hidden="true">dark_mode</span>
            <span class="material-symbols-outlined theme-icon-dark" aria-hidden="true">light_mode</span>
          </button>

          <button
            type="button"
            class="md-icon-btn md-mobile-menu-btn"
            id="mobile-drawer-toggle"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
          >
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Material 3 Modal Navigation Drawer (Mobile / Tablet) -->
    <div class="md-drawer-scrim" id="drawer-scrim" aria-hidden="true"></div>
    <aside class="md-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation Drawer" aria-hidden="true">
      <div class="md-drawer-header">
        <div class="md-brand-logo">
          <span class="md-brand-badge">
            <span class="material-symbols-outlined filled" aria-hidden="true">sports_bar</span>
          </span>
          <span class="md-brand-text">
            <span class="md-brand-title">S.F.Brews</span>
            <span class="md-brand-subtitle">Homebrewing</span>
          </span>
        </div>
        <button type="button" class="md-icon-btn" id="mobile-drawer-close" aria-label="Close navigation menu">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <div class="md-drawer-section-label">Destinations</div>
      <ul class="md-drawer-list">
        {
          navLinks.map((item) => {
            const isActive = checkActive(item.href, currentPath);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['md-drawer-item', 'md-ripple-surface', { active: isActive }]}
                >
                  <span class:list={['material-symbols-outlined', { filled: isActive }]} aria-hidden="true">
                    {item.icon}
                  </span>
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href={withBase('/journal')}
            class:list={[
              'md-drawer-item',
              'md-ripple-surface',
              { active: checkActive(withBase('/journal'), currentPath) },
            ]}
          >
            <span class="material-symbols-outlined" aria-hidden="true">manage_search</span>
            <span>Search &amp; Full Archive</span>
          </a>
        </li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="site-main">
      <slot />
    </main>

    <!-- Material 3 Footer -->
    <footer class="md-footer outer">
      <div class="md-footer-inner inner">
        <div class="md-footer-brand">
          <span class="md-brand-badge small">
            <span class="material-symbols-outlined filled" aria-hidden="true">sports_bar</span>
          </span>
          <div>
            <strong>S.F.Brews</strong> &copy; {new Date().getFullYear()}
            <p class="md-footer-tagline">All-Grain BrewZilla 4.1.1 Brewhouse &bull; Recipes, Trials &amp; Scoresheets</p>
          </div>
        </div>
        <nav class="md-footer-nav" aria-label="Footer Navigation">
          <a href={homeHref} class="md-footer-link">Home</a>
          <a href={withBase('/recipes')} class="md-footer-link">Recipes</a>
          <a href={withBase('/experiments')} class="md-footer-link">Experiments</a>
          <a href={withBase('/competitions')} class="md-footer-link">Competitions</a>
          <a href={withBase('/journal')} class="md-footer-link">Archive</a>
          <a href={withBase('/about')} class="md-footer-link">About</a>
        </nav>
      </div>
    </footer>

    <!-- Material 3 Mobile Bottom Navigation Bar -->
    <nav class="md-bottom-nav" aria-label="Mobile Quick Navigation">
      {
        bottomNavLinks.map((item) => {
          const isActive = checkActive(item.href, currentPath);
          return (
            <a
              href={item.href}
              class:list={['md-bottom-nav-item', 'md-ripple-surface', { active: isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="md-bottom-nav-indicator">
                <span class:list={['material-symbols-outlined', { filled: isActive }]} aria-hidden="true">
                  {item.icon}
                </span>
              </span>
              <span class="md-bottom-nav-label">{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <script>
      function initMaterialInteractions() {
        const topBar = document.getElementById('top-app-bar');
        const drawerToggle = document.getElementById('mobile-drawer-toggle');
        const drawerClose = document.getElementById('mobile-drawer-close');
        const drawer = document.getElementById('mobile-nav-drawer');
        const scrim = document.getElementById('drawer-scrim');
        const themeBtn = document.getElementById('theme-toggle-btn');

        // Scroll elevation state on Top App Bar
        const onScroll = () => {
          if (!topBar) return;
          if (window.scrollY > 12) {
            topBar.classList.add('is-scrolled');
          } else {
            topBar.classList.remove('is-scrolled');
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Mobile Modal Navigation Drawer
        const setDrawerOpen = (open: boolean) => {
          drawer?.classList.toggle('is-open', open);
          scrim?.classList.toggle('is-open', open);
          drawer?.setAttribute('aria-hidden', String(!open));
          drawerToggle?.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };

        drawerToggle?.addEventListener('click', () => setDrawerOpen(true));
        drawerClose?.addEventListener('click', () => setDrawerOpen(false));
        scrim?.addEventListener('click', () => setDrawerOpen(false));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
            setDrawerOpen(false);
          }
        });

        // Theme toggle button
        if (themeBtn && !themeBtn.dataset.bound) {
          themeBtn.dataset.bound = 'true';
          themeBtn.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('md-theme', next);
          });
        }

        // Material Ripple Effect on interactive surfaces
        const rippleTargets = document.querySelectorAll<HTMLElement>(
          '.md-ripple-surface, .md-btn, .md-icon-btn, .cat-btn'
        );
        rippleTargets.forEach((surface) => {
          if (surface.dataset.rippleBound) return;
          surface.dataset.rippleBound = 'true';
          surface.addEventListener('pointerdown', (e: PointerEvent) => {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const rect = surface.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const x = e.clientX - rect.left - size / 2;
            const y = e.clientY - rect.top - size / 2;

            const wave = document.createElement('span');
            wave.className = 'md-ripple-wave';
            wave.style.width = `${size}px`;
            wave.style.height = `${size}px`;
            wave.style.left = `${x}px`;
            wave.style.top = `${y}px`;
            surface.appendChild(wave);
            wave.addEventListener('animationend', () => wave.remove());
          });
        });

        // Scroll-triggered Material Entrance Animations
        const revealItems = document.querySelectorAll<HTMLElement>('.md-reveal');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
          );

          revealItems.forEach((item, index) => {
            if (!item.style.getPropertyValue('--reveal-delay')) {
              const stagger = (index % 6) * 55;
              item.style.setProperty('--reveal-delay', `${stagger}ms`);
            }
            observer.observe(item);
          });
        } else {
          revealItems.forEach((item) => item.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initMaterialInteractions);
    </script>
  </body>
</html>

<style>
  /* Material 3 Top App Bar — Clean & Airy */
  .md-top-app-bar {
    height: var(--top-bar-height);
    display: flex;
    align-items: center;
    background-color: color-mix(in srgb, var(--md-sys-color-surface) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    position: sticky;
    top: 0;
    z-index: 60;
    transition:
      background-color var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard),
      box-shadow var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard),
      border-color var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard);
  }

  .md-top-app-bar.is-scrolled {
    background-color: color-mix(in srgb, var(--md-sys-color-surface) 96%, transparent);
    box-shadow: var(--md-sys-elevation-1);
    border-bottom-color: var(--md-sys-color-outline-variant);
  }

  .md-top-app-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .md-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.65rem 0.35rem 0.35rem;
    border-radius: var(--md-sys-shape-corner-full);
  }

  .md-brand-badge {
    width: 42px;
    height: 42px;
    border-radius: var(--md-sys-shape-corner-medium);
    background-color: var(--palette-hop-green);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--md-sys-elevation-1);
    transition:
      transform var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-spring),
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .md-brand-badge.small {
    width: 36px;
    height: 36px;
    border-radius: var(--md-sys-shape-corner-small);
  }

  .md-brand-logo:hover .md-brand-badge {
    transform: rotate(-6deg) scale(1.05);
    background-color: var(--palette-amber-orange);
  }

  .md-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    gap: 0.14rem;
  }

  .md-brand-title {
    font-family: var(--font-brand);
    font-size: 1.38rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--md-sys-color-on-surface);
  }

  .md-brand-subtitle {
    font-family: var(--font-accent);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--md-sys-color-primary);
  }

  /* Desktop Navigation Pills — Uncluttered with Ample Breathing Space */
  .md-nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
  }

  .md-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: var(--md-sys-shape-corner-full);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    transition:
      background-color var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-emphasized),
      color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      transform var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-spring);
  }

  .md-nav-pill .nav-icon {
    font-size: 18px;
    color: var(--md-sys-color-primary);
    opacity: 0.85;
  }

  .md-nav-pill:hover {
    background-color: var(--md-state-hover);
    color: var(--md-sys-color-on-surface);
  }

  .md-nav-pill.active {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-weight: 700;
  }

  .md-nav-pill.active .nav-icon {
    color: var(--md-sys-color-primary);
    opacity: 1;
  }

  .md-app-bar-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .theme-icon-dark {
    display: none;
  }

  :global([data-theme='dark']) .theme-icon-light {
    display: none;
  }

  :global([data-theme='dark']) .theme-icon-dark {
    display: inline-flex;
  }

  .md-mobile-menu-btn {
    display: none;
  }

  /* Material 3 Modal Navigation Drawer */
  .md-drawer-scrim {
    position: fixed;
    inset: 0;
    background-color: var(--md-sys-color-scrim);
    backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    z-index: 80;
    transition: opacity var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard);
  }

  .md-drawer-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .md-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 86vw);
    background-color: var(--md-sys-color-surface);
    border-radius: var(--md-sys-shape-corner-extra-large) 0 0 var(--md-sys-shape-corner-extra-large);
    box-shadow: var(--md-sys-elevation-4);
    z-index: 90;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    transform: translateX(104%);
    transition: transform var(--md-sys-motion-duration-medium3) var(--md-sys-motion-easing-emphasized);
    overflow-y: auto;
  }

  .md-nav-drawer.is-open {
    transform: translateX(0);
  }

  .md-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.5rem 1.25rem;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    margin-bottom: 1rem;
  }

  .md-drawer-section-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--md-sys-color-outline);
    padding: 0.5rem 1rem;
  }

  .md-drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .md-drawer-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 52px;
    padding: 0 1.1rem;
    border-radius: var(--md-sys-shape-corner-full);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
  }

  .md-drawer-item:hover {
    background-color: var(--md-state-hover);
    color: var(--md-sys-color-on-surface);
  }

  .md-drawer-item.active {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .site-main {
    flex: 1;
  }

  /* Material 3 Footer — Generous Top Margin & Spacious Layout */
  .md-footer {
    margin-top: 7rem;
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    background-color: var(--md-sys-color-surface-container-low);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.9rem;
  }

  .md-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .md-footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .md-footer-brand strong {
    font-family: var(--font-brand);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--md-sys-color-on-surface);
    letter-spacing: 0.02em;
  }

  .md-footer-tagline {
    font-size: 0.82rem;
    color: var(--md-sys-color-outline);
    margin-top: 0.2rem;
  }

  .md-footer-nav {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .md-footer-link {
    padding: 0.45rem 0.85rem;
    border-radius: var(--md-sys-shape-corner-full);
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }

  .md-footer-link:hover {
    background-color: var(--md-state-hover);
    color: var(--md-sys-color-primary);
  }

  /* Material 3 Bottom Navigation Bar (Mobile / Tablet) */
  .md-bottom-nav {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background-color: color-mix(in srgb, var(--md-sys-color-surface) 95%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    box-shadow: var(--md-sys-elevation-2);
    z-index: 70;
    justify-content: space-around;
    align-items: center;
  }

  .md-bottom-nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.22rem;
    height: 100%;
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    user-select: none;
  }

  .md-bottom-nav-indicator {
    width: 60px;
    height: 30px;
    border-radius: var(--md-sys-shape-corner-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-emphasized),
      transform var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-spring);
  }

  .md-bottom-nav-item.active .md-bottom-nav-indicator {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    transform: scale(1.04);
  }

  .md-bottom-nav-item:active .md-bottom-nav-indicator {
    transform: scale(0.92);
  }

  .md-bottom-nav-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .md-bottom-nav-item.active .md-bottom-nav-label {
