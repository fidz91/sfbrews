---
import { srmToHex, srmDescription } from '../utils/srm';

interface Fermentable {
  name: string;
  weight: string;
  percentage: number;
  lovibond?: string;
  notes?: string;
}

interface Hop {
  name: string;
  weight: string;
  alphaAcid?: string;
  timing: string;
  use?: string;
  ibuContribution?: number;
}

interface MashStep {
  step: string;
  temp: string;
  duration: string;
  notes?: string;
}

interface RecipeData {
  batchSize: string;
  boilTime: string;
  efficiency?: string;
  og: number;
  fg: number;
  abv: number;
  ibu: number;
  srm: number;
  fermentables: Fermentable[];
  hops: Hop[];
  yeast: {
    name: string;
    lab?: string;
    code?: string;
    attenuation?: string;
    tempRange?: string;
    pitchNotes?: string;
  };
  mash?: MashStep[];
  waterProfile?: {
    profileName?: string;
    ca?: number;
    mg?: number;
    na?: number;
    cl?: number;
    so4?: number;
    hco3?: number;
    mashPh?: number;
    notes?: string;
  };
  fermentationNotes?: string;
}

interface Props {
  recipe: RecipeData;
  beerName: string;
  beerStyle?: string;
  batchNumber?: string;
}

const { recipe, beerName, beerStyle, batchNumber } = Astro.props;
const glassColor = srmToHex(recipe.srm);
const colorName = srmDescription(recipe.srm);
---

<section class="recipe-sheet" aria-label="Recipe Sheet">
  <div class="recipe-sheet-head">
    <h2 class="recipe-sheet-title">{beerName} &mdash; Recipe Specs</h2>
    <p class="recipe-sheet-sub">
      {batchNumber && <span>{batchNumber} &middot; </span>}
      {beerStyle && <span>{beerStyle} &middot; </span>}
      <span>Batch {recipe.batchSize}</span> &middot; <span>Boil {recipe.boilTime}</span>
      {recipe.efficiency && <span> &middot; Eff. {recipe.efficiency}</span>}
    </p>
  </div>

  <!-- Compact 4-Stat Mono Bar -->
  <div class="stats-bar">
    <div class="stat-cell">
      <span class="stat-label">OG &rarr; FG</span>
      <strong class="stat-value">
        {recipe.og.toFixed(3)} &rarr; {recipe.fg.toFixed(3)}
      </strong>
    </div>
    <div class="stat-cell">
      <span class="stat-label">ABV</span>
      <strong class="stat-value">{recipe.abv.toFixed(1)}%</strong>
    </div>
    <div class="stat-cell">
      <span class="stat-label">IBU</span>
      <strong class="stat-value">{recipe.ibu}</strong>
    </div>
    <div class="stat-cell">
      <span class="stat-label">SRM</span>
      <strong class="stat-value srm-cell" title={`${recipe.srm} SRM (${colorName})`}>
        <span class="srm-dot" style={`background-color: ${glassColor};`} />
        <span>{recipe.srm}</span>
      </strong>
    </div>
  </div>

  <!-- Fermentables / Grist Bill -->
  <div class="recipe-block">
    <h3 class="block-heading">Fermentables</h3>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Grain / Sugar</th>
            <th>Weight</th>
            <th>%</th>
            <th>Color</th>
          </tr>
        </thead>
        <tbody>
          {
            recipe.fermentables.map((grain) => (
              <tr>
                <td>
                  <strong>{grain.name}</strong>
                  {grain.notes && <div class="cell-note">{grain.notes}</div>}
                </td>
                <td class="nowrap mono-num">{grain.weight}</td>
                <td class="nowrap mono-num">{grain.percentage}%</td>
                <td class="nowrap mono-num">{grain.lovibond || '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Hop Additions -->
  <div class="recipe-block">
    <h3 class="block-heading">Hops</h3>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Variety</th>
            <th>Weight</th>
            <th>AA%</th>
            <th>Timing</th>
            <th>IBU</th>
          </tr>
        </thead>
        <tbody>
          {
            recipe.hops.map((hop) => (
              <tr>
                <td><strong>{hop.name}</strong></td>
                <td class="nowrap mono-num">{hop.weight}</td>
                <td class="nowrap mono-num">{hop.alphaAcid || '—'}</td>
                <td class="nowrap mono-num">
                  {hop.use ? `${hop.use} @ ${hop.timing}` : hop.timing}
                </td>
                <td class="nowrap mono-num">
                  {hop.ibuContribution !== undefined ? hop.ibuContribution : '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Compact 2-Column Mash, Yeast & Water Summary -->
  <div class="summary-grid">
    {
      recipe.mash && recipe.mash.length > 0 && (
        <div class="summary-box">
          <span class="mono-label">Mash Schedule</span>
          <ul class="summary-list">
            {recipe.mash.map((step) => (
              <li>
                <strong>{step.step}:</strong> {step.temp} for {step.duration}
                {step.notes ? ` — ${step.notes}` : ''}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="summary-box">
      <span class="mono-label">Yeast &amp; Fermentation</span>
      <p class="summary-text">
        <strong>
          {recipe.yeast.lab ? `${recipe.yeast.lab} ` : ''}
          {recipe.yeast.code ? `${recipe.yeast.code} ` : ''}
          {recipe.yeast.name}
        </strong>
        {recipe.yeast.attenuation && ` · Atten. ${recipe.yeast.attenuation}`}
        {recipe.yeast.tempRange && ` · ${recipe.yeast.tempRange}`}
      </p>
      {recipe.yeast.pitchNotes && <p class="cell-note">{recipe.yeast.pitchNotes}</p>}
      {recipe.fermentationNotes && <p class="cell-note">{recipe.fermentationNotes}</p>}
    </div>

    {
      recipe.waterProfile && (
        <div class="summary-box full-span">
          <span class="mono-label">
            Water Profile{recipe.waterProfile.profileName ? ` (${recipe.waterProfile.profileName})` : ''}
          </span>
          <p class="water-line">
            {[
              recipe.waterProfile.ca !== undefined ? `Ca ${recipe.waterProfile.ca}` : null,
              recipe.waterProfile.mg !== undefined ? `Mg ${recipe.waterProfile.mg}` : null,
              recipe.waterProfile.na !== undefined ? `Na ${recipe.waterProfile.na}` : null,
              recipe.waterProfile.so4 !== undefined ? `SO4 ${recipe.waterProfile.so4}` : null,
              recipe.waterProfile.cl !== undefined ? `Cl ${recipe.waterProfile.cl}` : null,
              recipe.waterProfile.hco3 !== undefined ? `HCO3 ${recipe.waterProfile.hco3}` : null,
              recipe.waterProfile.mashPh !== undefined
                ? `Mash pH ${recipe.waterProfile.mashPh.toFixed(2)}`
                : null,
            ]
              .filter(Boolean)
              .join(' · ')}
          </p>
          {recipe.waterProfile.notes && <p class="cell-note">{recipe.waterProfile.notes}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  .recipe-sheet {
    margin: 0 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .recipe-sheet-head {
    margin-bottom: 1rem;
  }

  .recipe-sheet-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
  }

  .recipe-sheet-sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-muted);
    margin-top: 0.25rem;
  }

  /* Compact 4-Stat Mono Bar */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-subtle);
    margin-bottom: 1.75rem;
  }

  .stat-cell {
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-cell + .stat-cell {
    border-left: 1px solid var(--border);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .srm-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .recipe-block {
    margin-bottom: 1.5rem;
  }

  .block-heading {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--forest);
    margin-bottom: 0.45rem;
  }

  .cell-note {
    font-size: 0.8rem;
    color: var(--ink-secondary);
    margin-top: 0.15rem;
  }

  .mono-num {
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .nowrap {
    white-space: nowrap;
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .summary-box {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.95rem 1.05rem;
    background-color: var(--bg);
  }

  .summary-box.full-span {
    grid-column: 1 / -1;
  }

  .summary-list {
    margin-top: 0.45rem;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--ink-secondary);
  }

  .summary-text {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .water-line {
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .stats-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-cell:nth-child(3) {
      border-left: none;
    }

    .stat-cell:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }

    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
