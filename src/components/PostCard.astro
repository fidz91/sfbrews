---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META, withBase } from '../utils/srm';

interface Props {
  post: CollectionEntry<'posts'>;
  large?: boolean;
}

const { post, large = false } = Astro.props;
const {
  title,
  description,
  pubDate,
  category,
  tags,
  beerStyle,
  batchNumber,
  readingTime,
  heroImage,
} = post.data;

const meta = CATEGORY_META[category];
const categoryIcons: Record<string, string> = {
  brewday: 'local_fire_department',
  recipe: 'menu_book',
  experiment: 'science',
  competition: 'emoji_events',
  news: 'campaign',
};
const catIcon = categoryIcons[category] || 'article';

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article
  class:list={['post-card', 'md-card', 'md-card-interactive', 'md-ripple-surface', 'md-reveal', { 'post-card-large': large }]}
  data-category={category}
  data-tags={tags.join(',').toLowerCase()}
  data-search={`${title} ${description} ${beerStyle || ''} ${batchNumber || ''} ${tags.join(' ')}`.toLowerCase()}
>
  {
    heroImage && (
      <a class="post-card-image-link" href={withBase(`/posts/${post.slug}`)} tabindex="-1" aria-hidden="true">
        <img
          class="post-card-image"
          src={heroImage}
          alt={title}
          loading={large ? 'eager' : 'lazy'}
          transition:name={`post-img-${post.slug}`}
        />
        {batchNumber && <span class="post-card-batch-pill">{batchNumber}</span>}
      </a>
    )
  }

  <div class="post-card-content">
    <a class="post-card-content-link" href={withBase(`/posts/${post.slug}`)}>
      <header class="post-card-header">
        <div class="post-card-chips">
          <span class:list={['primary-tag', `tag-${category}`]}>
            <span class="material-symbols-outlined tag-icon" aria-hidden="true">{catIcon}</span>
            {meta.plural}
          </span>
          {beerStyle && <span class="style-chip">{beerStyle}</span>}
        </div>
        <h2 class="post-card-title" transition:name={`post-title-${post.slug}`}>{title}</h2>
      </header>
      <p class="post-card-excerpt">{description}</p>
    </a>

    <footer class="post-card-meta">
      <div class="post-card-meta-info">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && <span class="meta-sep">&bull;</span>}
        {readingTime && <span>{readingTime}</span>}
      </div>
      <span class="post-card-action" aria-hidden="true">
        <span class="material-symbols-outlined">arrow_forward</span>
      </span>
    </footer>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-lowest);
  }

  .post-card-image-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: var(--md-sys-color-surface-container);
    border-radius: var(--md-sys-shape-corner-large);
    margin: 0.85rem 0.85rem 0;
  }

  .post-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasized);
  }

  .post-card:hover .post-card-image {
    transform: scale(1.04);
  }

  .post-card-batch-pill {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    background-color: color-mix(in srgb, var(--palette-deep-forest) 85%, transparent);
    backdrop-filter: blur(8px);
    color: var(--palette-pale-green);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.28rem 0.7rem;
    border-radius: var(--md-sys-shape-corner-full);
  }

  .post-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
    padding: 1.65rem 1.75rem 1.75rem;
  }

  .post-card-content-link {
    display: block;
  }

  .post-card-chips {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .post-card-chips .primary-tag {
    margin-bottom: 0;
  }

  .tag-icon {
    font-size: 14px;
  }

  .tag-recipe,
  .tag-brewday {
    background-color: var(--palette-pale-green);
    color: var(--palette-deep-forest);
  }

  .tag-experiment {
    background-color: color-mix(in srgb, var(--palette-fresh-green) 26%, var(--md-sys-color-surface));
    color: var(--palette-deep-forest);
  }

  .tag-competition {
    background-color: color-mix(in srgb, var(--palette-amber-orange) 18%, var(--md-sys-color-surface));
    color: var(--palette-deep-forest);
  }

  .tag-competition .tag-icon {
    color: var(--palette-amber-orange);
  }

  .style-chip {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--md-sys-color-outline);
    padding: 0.2rem 0.25rem;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.75rem;
    transition: color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .post-card:hover .post-card-title {
    color: var(--palette-hop-green);
  }

  .post-card-excerpt {
    font-size: 0.95rem;
    line-height: 1.68;
    color: var(--md-sys-color-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    margin-top: 1.65rem;
    padding-top: 1rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    font-size: 0.82rem;
    color: var(--md-sys-color-outline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .post-card-meta-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-card-action {
    width: 34px;
    height: 34px;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container);
    color: var(--palette-hop-green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-spring);
  }

  .post-card-action .material-symbols-outlined {
    font-size: 18px;
  }

  .post-card:hover .post-card-action {
    background-color: var(--palette-hop-green);
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Featured Hero Card on Desktop */
  @media (min-width: 960px) {
    .post-card-large {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 1.25rem;
      align-items: stretch;
      padding: 1rem;
    }

    .post-card-large .post-card-image-link {
      margin: 0;
      height: 100%;
      min-height: 360px;
      aspect-ratio: auto;
      border-radius: var(--md-sys-shape-corner-large);
    }

    .post-card-large .post-card-content {
      padding: 2.25rem 2.25rem 2rem;
    }

    .post-card-large .post-card-title {
      font-size: clamp(1.75rem, 2.5vw, 2.25rem);
      line-height: 1.22;
      margin-bottom: 1rem;
    }

    .post-card-large .post-card-excerpt {
      font-size: 1.04rem;
      -webkit-line-clamp: 4;
    }
  }
</style>
