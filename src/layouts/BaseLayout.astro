---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { withBase } from '../utils/srm';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'S.F.Brews — Homebrewing Recipes, Brewdays, Competitions & Experiments',
  description = 'Personal homebrewing journal documenting recipes, brewday logs, split-batch experiments, and competition results.',
  ogImage,
} = Astro.props;

const pathname = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanPath = pathname.startsWith(baseUrl) ? pathname.slice(baseUrl.length) || '/' : pathname;

const isJournalActive =
  cleanPath === '/' ||
  cleanPath.startsWith('/journal') ||
  cleanPath.startsWith('/posts') ||
  cleanPath.startsWith('/experiments') ||
  cleanPath.startsWith('/competitions');

const navLinks = [
  { href: '/', label: 'Journal', active: isJournalActive },
  { href: '/recipes', label: 'Recipes', active: cleanPath.startsWith('/recipes') },
  { href: '/about', label: 'About', active: cleanPath.startsWith('/about') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Google Fonts: Caprasimo, Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ViewTransitions />
  </head>
  <body>
    <!-- Ultra-Minimal 3-Link Top Bar -->
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand-wordmark" href={withBase('/')}>S.F.Brews</a>

        <nav class="top-nav" aria-label="Primary Navigation">
          {
            navLinks.map((item) => (
              <a
                href={withBase(item.href)}
                class:list={['nav-link', { active: item.active }]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <!-- Minimal Footer -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} <strong>S.F.Brews</strong> &mdash; Brewday &amp; recipe journal
        </p>
        <nav class="footer-nav" aria-label="Footer Navigation">
          <a href={withBase('/')}>Journal</a>
          <a href={withBase('/recipes')}>Recipes</a>
          <a href={withBase('/about')}>About</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    width: 100%;
    background-color: rgba(244, 240, 230, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .brand-wordmark:hover {
    color: var(--forest);
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-secondary);
    padding: 0.25rem 0;
    border-bottom: 1.5px solid transparent;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--forest);
    font-weight: 700;
    border-bottom-color: var(--forest);
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    margin-top: 4.5rem;
    border-top: 1px solid var(--border);
    padding: 1.75rem 0 2.25rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-muted);
  }

  .footer-copy strong {
    color: var(--ink);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-secondary);
  }

  .footer-nav a:hover {
    color: var(--forest);
  }

  @media (max-width: 540px) {
    .top-nav {
      gap: 1.15rem;
    }

    .nav-link {
      font-size: 0.72rem;
    }
  }
</style>
