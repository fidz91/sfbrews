---
import BaseLayout from '../layouts/BaseLayout.astro';
import TaplistBoard from '../components/TaplistBoard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';
import { resolveHomeHeroImage } from '../utils/images';
import { getHalftoneImage } from '../utils/halftone';

const homeHeroImage = resolveHomeHeroImage();
const homeHeroHalftone = await getHalftoneImage(homeHeroImage);

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <div class="container page-main">
    <!-- Compact Editorial Header + Two-Tone Threshold Banner -->
    <header class="editorial-hero">
      <div class="editorial-hero-copy">
        <span class="mono-label hero-kicker">Homebrewing Journal</span>
        <h1 class="hero-title">S.F.Brews</h1>
        <p class="hero-bio">
          Brewday and recipe writeups, competitions, experiments and everything beer related.
        </p>
      </div>

      {
        homeHeroImage && (
          <div class="editorial-hero-media zine-media">
            <img
              class="zine-img hero-img"
              src={homeHeroImage}
              alt="S.F.Brews"
              loading="eager"
            />
            {
              homeHeroHalftone && (
                <img
                  class="zine-halftone-img"
                  src={homeHeroHalftone}
                  alt=""
                  aria-hidden="true"
                  loading="eager"
                />
              )
            }
          </div>
        )
      }
    </header>

    <!-- Slim 1-Row Taplist / Fermenting / Next Up Status Bar -->
    <TaplistBoard />

    <!-- Category Filter Tabs -->
    <div class="filter-tabs" role="tablist" aria-label="Filter posts by category">
      <button class="filter-tab active" data-cat="all" type="button">All ({allPosts.length})</button>
      <button class="filter-tab" data-cat="brewday" type="button">Brewdays</button>
      <button class="filter-tab" data-cat="recipe" type="button">Recipes</button>
      <button class="filter-tab" data-cat="experiment" type="button">Experiments</button>
      <button class="filter-tab" data-cat="competition" type="button">Competitions</button>
    </div>

    <!-- Clean 2-Column Post Grid -->
    <section class="post-grid" id="home-post-grid" aria-label="Brew Logs">
      {
        allPosts.map((post, idx) => (
          <PostCard post={post} large={idx === 0} />
        ))
      }
    </section>

    <p id="home-empty-state" class="empty-msg" hidden>No posts in this category yet.</p>
  </div>
</BaseLayout>

<script>
  function initHomeFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('#home-post-grid .post-card');
    const emptyState = document.getElementById('home-empty-state');
    if (!tabs.length) return;

    let activeCat = 'all';

    function applyFilter() {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const tags = (card.dataset.tags || '').split(',');
        const matches = activeCat === 'all' || cat === activeCat || tags.includes(activeCat);
        card.style.display = matches ? 'flex' : 'none';
        if (matches) visible++;
      });
      if (emptyState) emptyState.hidden = visible > 0;
    }

    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    if (urlCat) {
      activeCat = urlCat;
      tabs.forEach((t) => t.classList.toggle('active', t.dataset.cat === activeCat));
    }
    applyFilter();

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeCat = tab.dataset.cat || 'all';
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        applyFilter();
      });
    });
  }

  document.addEventListener('astro:page-load', initHomeFilters);
</script>

<style>
  .page-main {
    padding-top: 2.5rem;
  }

  .editorial-hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2rem;
    align-items: center;
    padding-bottom: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-kicker {
    display: block;
    color: var(--forest);
    margin-bottom: 0.45rem;
  }

  .hero-title {
    font-size: clamp(2.1rem, 4.2vw, 2.85rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 0.55rem;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 480px;
  }

  .editorial-hero-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Category Filter Tabs */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }

  .filter-tab {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.38rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .filter-tab.active {
    background-color: var(--forest-tint);
    border-color: var(--forest);
    color: var(--forest);
  }

  /* 2-Column Post Grid */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .empty-msg {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-muted);
    padding: 2rem 0;
  }

  @media (max-width: 760px) {
    .page-main {
      padding-top: 1.75rem;
    }

    .editorial-hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
