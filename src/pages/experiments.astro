---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const experimentPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .filter((post) => post.data.category === 'experiment' || post.data.experiment !== undefined)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Brewing Experiments — SFBrews"
  description="Controlled split-batch homebrewing experiments and sensory comparisons."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="md-page-banner md-reveal">
        <span class="banner-icon-badge">
          <span class="material-symbols-outlined filled" aria-hidden="true">science</span>
        </span>
        <div>
          <span class="banner-kicker">Split-Batch Sensory Lab</span>
          <h1>Brewing Experiments</h1>
          <p>
            Controlled split-batch trials, single-variable process comparisons, and blind triangle tasting panels.
          </p>
        </div>
      </header>

      {
        experimentPosts.length > 0 ? (
          <div class="post-feed">
            {experimentPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="md-empty-card md-reveal">
            <span class="material-symbols-outlined empty-icon" aria-hidden="true">science</span>
            <h3>Experiments Coming Soon</h3>
            <p>
              Split-batch trials and triangle test writeups will appear here once published.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 2rem;
  }

  .md-page-banner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: clamp(1.35rem, 3vw, 2.25rem);
    margin-bottom: 2.25rem;
    box-shadow: var(--md-sys-elevation-1);
  }

  .banner-icon-badge {
    width: 54px;
    height: 54px;
    border-radius: var(--md-sys-shape-corner-large);
    background-color: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .banner-icon-badge .material-symbols-outlined {
    font-size: 26px;
  }

  .banner-kicker {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--md-sys-color-tertiary);
    margin-bottom: 0.2rem;
  }

  .md-page-banner h1 {
    font-size: clamp(1.8rem, 4vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.45rem;
    color: var(--md-sys-color-on-surface);
  }

  .md-page-banner p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1rem;
    max-width: 680px;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .md-empty-card {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px dashed var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  .empty-icon {
    font-size: 42px;
    color: var(--md-sys-color-outline);
    margin-bottom: 0.75rem;
  }

  .md-empty-card h3 {
    font-size: 1.2rem;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 960px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.35rem;
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 1.25rem;
    }

    .md-page-banner {
      flex-direction: column;
      gap: 0.85rem;
    }

    .post-feed {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
