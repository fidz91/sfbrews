---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Archive & Search — SFBrews"
  description="Browse and search all brewdays, recipes, experiments, competitions, and news."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="page-head">
        <h1>Archive &amp; Search</h1>
        <div class="filter-bar">
          <input
            type="search"
            id="journal-search"
            placeholder="Search recipes, hops, malts, or brewdays..."
            aria-label="Search posts"
          />
          <div class="cat-pills" role="tablist">
            <button class="cat-btn active" data-cat="all">All</button>
            <button class="cat-btn" data-cat="brewday">Brewdays</button>
            <button class="cat-btn" data-cat="recipe">Recipes</button>
            <button class="cat-btn" data-cat="experiment">Experiments</button>
            <button class="cat-btn" data-cat="competition">Competitions</button>
            <button class="cat-btn" data-cat="news">Equipment &amp; News</button>
          </div>
        </div>
      </header>

      <div class="post-feed" id="journal-grid">
        {allPosts.map((post) => <PostCard post={post} />)}
      </div>

      <p id="empty-state" class="empty-msg" hidden>No matching articles found.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('journal-search') as HTMLInputElement;
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('#journal-grid .post-card');
  const emptyState = document.getElementById('empty-state');

  let activeCat = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cat = card.dataset.category || '';
      const tags = (card.dataset.tags || '').split(',');
      const text = card.dataset.search || '';
      const matchesCat =
        activeCat === 'all' || cat === activeCat || tags.includes(activeCat);
      const matchesSearch = !searchQuery || text.includes(searchQuery.toLowerCase());

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) emptyState.hidden = visible > 0;
  }

  const params = new URLSearchParams(window.location.search);
  const urlCat = params.get('category');
  const urlQuery = params.get('q');

  if (urlCat) {
    activeCat = urlCat;
    catButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.cat === activeCat));
  }
  if (urlQuery && searchInput) {
    searchQuery = urlQuery;
    searchInput.value = urlQuery;
  }
  applyFilters();

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    applyFilters();
  });

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat || 'all';
      catButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });
</script>

<style>
  .page-wrap {
    padding-top: 4rem;
  }

  .page-head {
    margin-bottom: 4rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  #journal-search {
    width: 100%;
    max-width: 540px;
    padding: 0.85rem 1.15rem;
    font-family: var(--font-sans);
    font-size: 0.96rem;
    border: 1px solid var(--border);
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--bg-soft);
    color: var(--text-main);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #journal-search:focus {
    outline: none;
    border-color: var(--palette-hop-green);
    box-shadow: 0 0 0 3px var(--palette-pale-green);
    background-color: var(--md-sys-color-surface-container-lowest);
  }

  .cat-pills {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem 1.05rem;
    border-radius: 99px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-body);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-btn:hover {
    border-color: var(--palette-fresh-green);
    background-color: var(--md-state-hover);
  }

  .cat-btn.active {
    background-color: var(--palette-hop-green);
    border-color: var(--palette-hop-green);
    color: #ffffff;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.75rem 2.75rem;
  }

  .empty-msg {
    color: var(--text-muted);
    padding: 2.5rem 0;
  }

  @media (max-width: 960px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2.5rem;
    }
    .post-feed {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
