---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Archive & Search — SFBrews"
  description="Browse and search all brewdays, recipes, experiments, competitions, and news."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="page-head">
        <span class="page-eyebrow">Cellar Archive</span>
        <h1>Archive &amp; Search</h1>
        <div class="filter-bar">
          <div class="search-input-wrap">
            <span class="material-symbols-outlined search-icon">search</span>
            <input
              type="search"
              id="journal-search"
              placeholder="Search recipes, hops, malts, or brewdays..."
              aria-label="Search posts"
            />
          </div>
          <div class="cat-pills" role="tablist">
            <button class="cat-btn active" data-cat="all">All</button>
            <button class="cat-btn" data-cat="brewday">Brewdays</button>
            <button class="cat-btn" data-cat="recipe">Recipes</button>
            <button class="cat-btn" data-cat="experiment">Experiments</button>
            <button class="cat-btn" data-cat="competition">Competitions</button>
            <button class="cat-btn" data-cat="news">Equipment &amp; News</button>
          </div>
        </div>
      </header>

      <div class="post-feed" id="journal-grid">
        {allPosts.map((post) => <PostCard post={post} />)}
      </div>

      <p id="empty-state" class="empty-msg" hidden>No matching articles found.</p>
    </div>
  </div>
</BaseLayout>

<script>
  function initJournalSearch() {
    const searchInput = document.getElementById('journal-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('#journal-grid .m3-post-card');
    const emptyState = document.getElementById('empty-state');

    let activeCat = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const tags = (card.dataset.tags || '').split(',');
        const text = card.dataset.search || '';
        const matchesCat =
          activeCat === 'all' || cat === activeCat || tags.includes(activeCat);
        const matchesSearch = !searchQuery || text.includes(searchQuery.toLowerCase());

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) emptyState.hidden = visible > 0;
    }

    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    const urlQuery = params.get('q');

    if (urlCat) {
      activeCat = urlCat;
      catButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.cat === activeCat));
    }
    if (urlQuery && searchInput) {
      searchQuery = urlQuery;
      searchInput.value = urlQuery;
    }
    applyFilters();

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applyFilters();
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.cat || 'all';
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
    });
  }

  document.addEventListener('astro:page-load', initJournalSearch);
</script>

<style>
  .page-wrap {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .page-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--md-sys-color-primary);
    display: block;
    margin-bottom: 0.35rem;
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-input-wrap {
    position: relative;
    max-width: 540px;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--md-sys-color-outline);
    font-size: 1.15rem;
    pointer-events: none;
  }

  #journal-search {
    width: 100%;
    padding: 0.78rem 1.15rem 0.78rem 2.75rem;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  #journal-search:focus {
    outline: none;
    border: 2px solid var(--md-sys-color-primary);
    background-color: var(--md-sys-color-surface-container-lowest);
  }

  .cat-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    height: 34px;
    padding: 0 0.95rem;
    border-radius: var(--md-sys-shape-corner-full);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-btn:hover {
    border-color: var(--md-sys-color-primary);
    background-color: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
  }

  .cat-btn.active {
    background-color: var(--md-sys-color-secondary-container);
    border-color: var(--md-sys-color-secondary);
    color: var(--md-sys-color-on-secondary-container);
    font-weight: 700;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .empty-msg {
    color: var(--md-sys-color-outline);
    padding: 2.5rem 0;
  }

  @media (max-width: 1024px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2rem;
    }

    .post-feed {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
