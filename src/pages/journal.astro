---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Archive & Search — SFBrews"
  description="Browse and search all brewdays, recipes, experiments, competitions, and news."
>
  <div class="container page-wrap">
    <header class="page-head">
      <span class="mono-label page-kicker">Archive &amp; Search</span>
      <h1>All Brew Logs</h1>
      <div class="filter-bar">
        <input
          type="search"
          id="journal-search"
          placeholder="Search recipes, hops, malts, or brewdays..."
          aria-label="Search posts"
        />
        <div class="cat-pills" role="tablist">
          <button class="cat-btn active" data-cat="all" type="button">All</button>
          <button class="cat-btn" data-cat="brewday" type="button">Brewdays</button>
          <button class="cat-btn" data-cat="recipe" type="button">Recipes</button>
          <button class="cat-btn" data-cat="experiment" type="button">Experiments</button>
          <button class="cat-btn" data-cat="competition" type="button">Competitions</button>
          <button class="cat-btn" data-cat="news" type="button">Equipment &amp; News</button>
        </div>
      </div>
    </header>

    <div class="post-grid" id="journal-grid">
      {allPosts.map((post) => <PostCard post={post} />)}
    </div>

    <p id="empty-state" class="empty-msg" hidden>No matching articles found.</p>
  </div>
</BaseLayout>

<script>
  function initJournalSearch() {
    const searchInput = document.getElementById('journal-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('#journal-grid .post-card');
    const emptyState = document.getElementById('empty-state');

    let activeCat = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const tags = (card.dataset.tags || '').split(',');
        const text = card.dataset.search || '';
        const matchesCat =
          activeCat === 'all' || cat === activeCat || tags.includes(activeCat);
        const matchesSearch = !searchQuery || text.includes(searchQuery.toLowerCase());

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) emptyState.hidden = visible > 0;
    }

    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    const urlQuery = params.get('q');

    if (urlCat) {
      activeCat = urlCat;
      catButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.cat === activeCat));
    }
    if (urlQuery && searchInput) {
      searchQuery = urlQuery;
      searchInput.value = urlQuery;
    }
    applyFilters();

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applyFilters();
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.cat || 'all';
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
    });
  }

  document.addEventListener('astro:page-load', initJournalSearch);
</script>

<style>
  .page-wrap {
    padding-top: 2.5rem;
  }

  .page-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-kicker {
    display: block;
    color: var(--forest);
    margin-bottom: 0.4rem;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 3.8vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  #journal-search {
    width: 100%;
    max-width: 480px;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background-color: var(--bg);
    color: var(--ink);
  }

  #journal-search:focus {
    outline: none;
    border-color: var(--forest);
  }

  .cat-pills {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.38rem 0.8rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
    cursor: pointer;
  }

  .cat-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .cat-btn.active {
    background-color: var(--forest-tint);
    border-color: var(--forest);
    color: var(--forest);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .empty-msg {
    font-family: var(--font-mono);
    color: var(--ink-muted);
    padding: 2rem 0;
  }

  @media (max-width: 760px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
