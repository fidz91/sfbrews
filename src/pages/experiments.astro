---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const experimentPosts = (await getCollection('posts'))
  .filter((post) => isPostVisible(post) && (post.data.category === 'experiment' || post.data.experiment !== undefined))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Brewing Experiments — SFBrews"
  description="Controlled split-batch homebrewing experiments and sensory comparisons."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="page-head">
        <span class="page-eyebrow">Split-Batch Trials</span>
        <h1>Brewing Experiments</h1>
        <p>Controlled split-batch trials, ingredient comparisons, and blind triangle tests.</p>
      </header>

      {
        experimentPosts.length > 0 ? (
          <div class="post-feed">
            {experimentPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-box">
            <p><strong>No experiments published yet.</strong></p>
            <p class="muted">
              Split-batch trials and brewing experiments will be added here as they are completed.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .page-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--md-sys-color-primary);
    display: block;
    margin-bottom: 0.35rem;
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .page-head p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1.05rem;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .empty-box {
    padding: 2rem 2.25rem;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .empty-box p {
    margin: 0.35rem 0;
  }

  .muted {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.94rem;
  }

  @media (max-width: 1024px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2rem;
    }

    .post-feed {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
