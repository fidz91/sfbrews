---
import BaseLayout from '../layouts/BaseLayout.astro';
import TaplistBoard from '../components/TaplistBoard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const allPosts = (await getCollection('posts'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <!-- Minimalist Cover Header -->
  <div class="site-header-content outer">
    <img
      class="site-header-cover"
      src="https://images.unsplash.com/photo-1559526323-cb2f2fe2591b?auto=format&fit=crop&w=2000&q=80"
      alt="S.F.Brews"
    />
    <div class="site-header-inner inner">
      <h1 class="site-title">S.F.Brews</h1>
      <p class="site-description">
        Brewday and recipe writeups, competitions, experiments and everything beer related.
      </p>
    </div>
  </div>

  <!-- Main Content & Post Feed -->
  <div class="outer">
    <div class="inner">
      <TaplistBoard />

      <div class="post-feed">
        {
          allPosts.map((post, idx) => (
            <PostCard post={post} large={idx === 0} />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .site-header-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    text-align: center;
    color: #ffffff;
    background-color: var(--palette-deep-forest);
    overflow: hidden;
    margin-bottom: 4rem;
  }

  .site-header-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    mix-blend-mode: luminosity;
  }

  .site-header-inner {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }

  .site-title {
    font-family: var(--font-brand);
    font-size: clamp(3rem, 7vw, 4.75rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.08;
    color: #ffffff;
    margin-bottom: 0.9rem;
  }

  .site-description {
    font-family: var(--font-accent);
    font-size: clamp(1.08rem, 2.2vw, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--palette-pale-green);
    line-height: 1.6;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.75rem 2.75rem;
  }

  @media (max-width: 960px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }

  @media (max-width: 640px) {
    .site-header-content {
      min-height: 260px;
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
      margin-bottom: 2.75rem;
    }

    .post-feed {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
