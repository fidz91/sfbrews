---
import { ACTIVE_TAPS, ACTIVE_FERMENTERS, UPCOMING_BREWS } from '../data/taplist';
import { withBase } from '../utils/srm';
---

<section class="status-strip" id="taplist" aria-label="Currently On Tap, Fermenting, and Upcoming">
  <div class="status-cell">
    <span class="status-key">
      <span class="tap-dot" aria-hidden="true"></span>
      ON TAP
    </span>
    <span class="status-val">
      {
        ACTIVE_TAPS.length > 0 ? (
          ACTIVE_TAPS.map((tap, idx) => (
            <>
              {idx > 0 && <span class="sep">, </span>}
              {tap.postSlug ? (
                <a href={withBase(`/posts/${tap.postSlug}`)} class="status-link">
                  {tap.name}
                </a>
              ) : (
                <span>{tap.name}</span>
              )}
              {(tap.bjcpCode || tap.abv !== undefined) && (
                <span class="status-meta">
                  {' '}
                  ({[tap.bjcpCode, tap.abv !== undefined ? `${tap.abv.toFixed(1)}%` : null]
                    .filter(Boolean)
                    .join(' · ')})
                </span>
              )}
            </>
          ))
        ) : (
          <span class="status-muted">None</span>
        )
      }
    </span>
  </div>

  <div class="status-cell">
    <span class="status-key">FERMENTING</span>
    <span class="status-val">
      {
        ACTIVE_FERMENTERS.length > 0 ? (
          ACTIVE_FERMENTERS.map((fv, idx) => (
            <>
              {idx > 0 && <span class="sep">, </span>}
              {fv.postSlug ? (
                <a href={withBase(`/posts/${fv.postSlug}`)} class="status-link">
                  {fv.name}
                </a>
              ) : (
                <span>{fv.name}</span>
              )}
              <span class="status-meta"> ({fv.stage})</span>
            </>
          ))
        ) : (
          <span class="status-muted">Empty</span>
        )
      }
    </span>
  </div>

  <div class="status-cell">
    <span class="status-key">NEXT UP</span>
    <span class="status-val">
      {
        UPCOMING_BREWS.length > 0 ? (
          UPCOMING_BREWS.map((up, idx) => (
            <>
              {idx > 0 && <span class="sep">, </span>}
              {up.postSlug ? (
                <a href={withBase(`/posts/${up.postSlug}`)} class="status-link">
                  {up.name}
                </a>
              ) : (
                <span>{up.name}</span>
              )}
            </>
          ))
        ) : (
          <span class="status-muted">TBD</span>
        )
      }
    </span>
  </div>
</section>

<style>
  .status-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-subtle);
    margin-bottom: 2rem;
  }

  .status-cell {
    padding: 0.72rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .status-cell + .status-cell {
    border-left: 1px solid var(--border);
  }

  .status-key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .tap-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--forest);
    display: inline-block;
  }

  .status-val {
    color: var(--ink);
    font-weight: 500;
  }

  .status-link {
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(27, 77, 46, 0.35);
    text-underline-offset: 2px;
  }

  .status-link:hover {
    color: var(--forest);
    text-decoration-color: var(--forest);
  }

  .status-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-secondary);
  }

  .status-muted {
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .status-strip {
      grid-template-columns: 1fr;
    }

    .status-cell + .status-cell {
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }
</style>
