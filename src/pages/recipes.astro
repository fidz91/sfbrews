---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '../utils/srm';

const recipePosts = (await getCollection('posts'))
  .filter((post) => isPostVisible(post) && (post.data.recipe !== undefined || post.data.category === 'recipe'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Homebrewing Recipes — SFBrews"
  description="All-grain homebrewing recipes with grist bill percentages, hop schedules, and brewday notes."
>
  <div class="container page-wrap">
    <header class="page-head">
      <span class="mono-label page-kicker">Formulation Archive</span>
      <h1>Recipes &amp; Brewdays</h1>
      <p>All-grain formulations with grist bill percentages, hop schedules, water profiles, and brewday logs.</p>
    </header>

    {
      recipePosts.length > 0 ? (
        <div class="post-grid">
          {recipePosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty-msg">No recipes published yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-wrap {
    padding-top: 2.5rem;
  }

  .page-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-kicker {
    display: block;
    color: var(--forest);
    margin-bottom: 0.4rem;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 3.8vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.45rem;
  }

  .page-head p {
    color: var(--ink-secondary);
    font-size: 1rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .empty-msg {
    font-family: var(--font-mono);
    color: var(--ink-muted);
    padding: 2rem 0;
  }

  @media (max-width: 760px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
